---
import ProBase from '../layouts/ProBase.astro';
import ProductTile from '../../../src/components/ProductTile.astro';
import ProTrust from '../components/ProTrust.astro';
import LeadSheet from '../components/LeadSheet.astro';
import { AUDIENCES, SITE } from '../data/pro';
import ArtHero from '../../../src/components/ArtHero.astro';
import { artFor } from '../../../src/data/details';

// /sourcers and /agents.
export function getStaticPaths() {
  return AUDIENCES.map((a) => ({ params: { audience: a.slug } }));
}
const { audience } = Astro.params as { audience: string };
const a = AUDIENCES.find((x) => x.slug === audience)!;
const other = AUDIENCES.find((x) => x.slug !== audience)!;
// The hero shows the artwork of the first product with artwork.
const lead = a.products.find((p) => artFor(p.key))!;
---
<ProBase title={a.title} description={a.lede}>
  <header class="rp-hero">
    <div class="rp-wrap rp-hero-grid">
      <div>
        <p class="rp-eyebrow">Salet Pro · for {a.label.toLowerCase()}</p>
        <h1 class="rp-h1">{a.h1}</h1>
        <p class="rp-lede">{a.lede}</p>
        <a class="rp-btn" href="/sample-leads">See a sample lead sheet</a>
      </div>
      <div class="rp-hero-art"><ArtHero productKey={lead.key} alt="" sizes="(min-width: 56rem) 520px, 100vw" eager /></div>
    </div>
  </header>

  <ProTrust />

  <section class="rp-section">
    <div class="rp-wrap">
      <p id="notified" class="rp-thanks" hidden>Thank you. We will email you the day it goes live, and only then.</p>
      <h2 class="rp-h2">Tools for {a.label.toLowerCase()}</h2>
      <p class="rp-sub">One payment by card. Products marked coming soon take your email and tell you the day they go live.</p>
      <div class="rp-tiles">{a.products.map((p) => <ProductTile p={p} back={`${SITE}/${a.slug}`} />)}</div>
    </div>
  </section>

  {a.leads && (
    <section class="rp-section" style="padding-top:0">
      <div class="rp-wrap">
        <h2 class="rp-h2">What a lead sheet looks like</h2>
        <LeadSheet limit={3} />
      </div>
    </section>
  )}

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap" style="max-width:48rem">
      <h2 class="rp-h2">Questions</h2>
      <div class="rp-faq">
        {a.faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
      <div class="rp-chips" style="margin-top:2rem">
        <a href={`/${other.slug}`}>For {other.label.toLowerCase()}</a>
        <a href="/pricing">All prices</a>
        <a href="/contact">Talk to us</a>
      </div>
    </div>
  </section>
</ProBase>
