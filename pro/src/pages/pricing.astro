---
import ProBase from '../layouts/ProBase.astro';
import ProductTile from '../../../src/components/ProductTile.astro';
import ProTrust from '../components/ProTrust.astro';
import { ALL_PRO, SITE, LEADS_SCOPE } from '../data/pro';
---
<ProBase
  title="Pricing | Salet Pro"
  description="Off-market leads £49 per area for 30 days, Seller Leads £79 per patch, Investor Pack Builder £15, Valuation Evidence Pack £15, Area Market Brief £49, Sourcer Pass £99."
>
  <header class="rp-hero">
    <div class="rp-wrap">
      <p class="rp-eyebrow">Salet Pro · pricing</p>
      <h1 class="rp-h1">One payment. Nothing renews on its own.</h1>
      <p class="rp-lede">Pay per pack, or for 30 days of leads. Real subscriptions come later, and only if you ask for them.</p>
    </div>
  </header>
  <ProTrust />
  <section class="rp-section">
    <div class="rp-wrap">
      <p id="notified" class="rp-thanks" hidden>Thank you. We will email you the day it goes live, and only then.</p>
      <p class="pro-scope">{LEADS_SCOPE}</p>
      <div class="rp-tiles">{ALL_PRO.map((p) => <ProductTile p={p} back={`${SITE}/pricing`} />)}</div>
      <p class="rp-sub" style="margin-top:2rem;font-size:0.9rem">
        Salet Ltd is not VAT registered, so the price shown is the price you pay.
      </p>
    </div>
  </section>
</ProBase>
