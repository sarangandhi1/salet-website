---
import ProBase from '../layouts/ProBase.astro';
import ProductTile from '../../../src/components/ProductTile.astro';
import ProTrust from '../components/ProTrust.astro';
import LeadSheet from '../components/LeadSheet.astro';
import { AUDIENCES, LEADS, PACKS, PASSES, DATA, SITE } from '../data/pro';
import ArtHero from '../../../src/components/ArtHero.astro';

// Artwork for each audience tile.
const AUD_ART: Record<string, string> = { sourcers: 'offmarket', agents: 'seller-leads' };

const groups = [
  { id: 'leads', h: 'Leads', sub: 'Homes whose owners may want to sell, found in public records, every week.', items: LEADS },
  { id: 'packs', h: 'Packs', sub: 'Address in, a sourced and branded pack out.', items: PACKS },
  { id: 'passes', h: 'Passes', sub: 'Thirty days of packs and leads for one payment.', items: PASSES },
  { id: 'data', h: 'Data and research', sub: 'District figures for agents, lenders and property technology firms, and bespoke sweeps for funds and family offices.', items: DATA },
];
---
<ProBase
  title="Salet Pro | Off-market leads and property packs for professionals"
  description="Homes in your area whose owners may want to sell, every week, branded investor packs and valuation evidence. For deal sourcers and estate agents."
>
  <header class="rp-hero">
    <div class="rp-wrap rp-hero-grid">
      <div>
      <p class="rp-eyebrow">Salet Pro · for property professionals</p>
      <h1 class="rp-h1">The leads your competitors don&rsquo;t have</h1>
      <p class="rp-lede">
        Every week, the homes in your area whose owners may want to sell, before they reach Rightmove. Then package
        the deal or win the instruction, in minutes. For deal sourcers and estate agents.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.75rem">
        <a class="rp-btn" href="/sample-leads">See a sample lead sheet</a>
        <a class="rp-btn is-soon" href="/pricing">Pricing</a>
      </div>
      </div>
      <div class="rp-hero-art"><ArtHero productKey="offmarket" alt="" sizes="(min-width: 56rem) 520px, 100vw" eager /></div>
    </div>
  </header>

  <ProTrust />

  <section class="rp-section">
    <div class="rp-wrap">
      <p id="notified" class="rp-thanks" hidden>Thank you. We will email you the day it goes live, and only then.</p>
      <h2 class="rp-h2">Who it is for</h2>
      <div class="rp-tiles" style="margin-top:1.5rem">
        {AUDIENCES.map((a) => (
          <a href={`/${a.slug}`} class="rp-tile" style="text-decoration:none;color:inherit">
            <span class="rp-tile-vis"><ArtHero productKey={AUD_ART[a.slug]} alt="" /></span>
            <span class="rp-tile-body">
              <h3>{a.label}</h3>
              <span class="rp-promise">{a.h1}.</span>
              <span class="rp-more" style="text-align:left">See the tools &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="rp-section" style="padding-top:0" id={g.id}>
      <div class="rp-wrap">
        <h2 class="rp-h2">{g.h}</h2>
        <p class="rp-sub">{g.sub}</p>
        <div class="rp-tiles">{g.items.map((p) => <ProductTile p={p} back={`${SITE}/`} />)}</div>
      </div>
    </section>
  ))}

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap">
      <h2 class="rp-h2">What a lead sheet looks like</h2>
      <LeadSheet limit={3} />
      <p style="margin-top:1rem"><a class="rp-link" style="color:var(--navy-600)" href="/sample-leads">See the full sample</a></p>
    </div>
  </section>
</ProBase>
