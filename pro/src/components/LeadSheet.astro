---
import { LEAD_SAMPLE, LEAD_STATS, LEADS_SCOPE } from '../data/pro';

// The masked sample lead sheet, as tiles. See LEAD_SAMPLE for what is hidden.
interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const leads = limit ? LEAD_SAMPLE.slice(0, limit) : LEAD_SAMPLE;
---
<p class="pro-scope">{LEADS_SCOPE}</p>
<div class="rp-stats">
  {LEAD_STATS.map((s) => <div class="rp-stat"><b>{s.n}</b><span>{s.label}</span></div>)}
</div>
<div class="rp-tiles">
  {leads.map((l) => (
    <div class="rp-lead">
      <span class="rp-ltype">{l.type}</span>
      <p class="rp-laddr">{l.addr}</p>
      <dl>
        <dt>Signal</dt><dd>{l.signal}</dd>
        <dt>Last sale</dt><dd>{l.sale}</dd>
        <dt>Route in</dt><dd>{l.route}</dd>
      </dl>
    </div>
  ))}
</div>
<p class="rp-sub" style="margin:1.5rem 0 0;font-size:0.9rem">
  From a real preview edition for Perry Barr, Birmingham, October 2026. On this public page the house numbers, the
  street names and the end of each postcode are removed. The paid sheet names every property. No owner names, ever.
</p>
