---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Page-specific share image. Defaults to the brand card. */
  image?: string;
}

const { title, description, noindex = false, image = '/og/salet-og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Structured data. Salet is a professional service, not a shop or a local
// storefront, so ProfessionalService is the honest type. Only facts that are
// true and verifiable go in here: the legal entity, the registered office and
// the contact route. Nothing about ratings, prices or reviews, because there
// are none to declare and inventing them is how a business earns a manual
// action rather than a rich result.
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://salet.uk/#organisation',
  name: 'Salet',
  legalName: 'Salet Ltd',
  url: 'https://salet.uk',
  logo: 'https://salet.uk/og/salet-og.png',
  image: 'https://salet.uk/og/salet-og.png',
  description:
    'Buyer-only property concierge for UK property. Salet searches, analyses, negotiates and manages the purchase, acting only for the buyer.',
  email: 'saran@salet.uk',
  telephone: '+44 7878 781100',
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '71-75 Shelton Street, Covent Garden',
    addressLocality: 'London',
    postalCode: 'WC2H 9JQ',
    addressCountry: 'GB',
  },
  knowsAbout: [
    'Buying agent',
    'Buyer representation',
    'UK property purchase',
    'Auction legal pack review',
    'Property due diligence',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://salet.uk/#website',
  url: 'https://salet.uk',
  name: 'Salet',
  publisher: { '@id': 'https://salet.uk/#organisation' },
  inLanguage: 'en-GB',
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Salet" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    <meta name="theme-color" content="#1b1a17" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-green focus:text-ivory focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal, .reveal-scale').forEach((el) => observer.observe(el));

      // Scroll progress bar
      const bar = document.getElementById('scroll-progress');
      let ticking = false;
      const paint = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        ticking = false;
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(paint);
          }
        },
        { passive: true }
      );
      paint();

      // Animated counters
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const counterObs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            counterObs.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const target = parseFloat(el.dataset.count || '0');
            const suffix = el.dataset.suffix || '';
            const dur = 1600;
            const t0 = performance.now();
            const step = (now: number) => {
              const p = Math.min((now - t0) / dur, 1);
              el.textContent = Math.round(ease(p) * target).toLocaleString('en-GB') + suffix;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        },
        { threshold: 0.4 }
      );
      document.querySelectorAll('[data-count]').forEach((el) => counterObs.observe(el));
    </script>
  </body>
</html>
