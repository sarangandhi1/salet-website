---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  lede: string;
  readingTime?: string;
}
const { title, description, eyebrow, heroTitle, lede, readingTime } = Astro.props;
---
<Base title={title} description={description}>
  <PageHero eyebrow={eyebrow} title={heroTitle} lede={lede} compact>
    {readingTime && <p class="reveal reveal-d3 mt-6 text-xs uppercase tracking-[0.2em] text-mist">{readingTime}</p>}
  </PageHero>
  <article class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="prose-salet">
      <slot />
    </div>
    <div class="rule mt-16"></div>
    <p class="mt-8 text-sm leading-relaxed text-stone">
      Salet provides property consulting and buyer representation. This article is general information, not financial,
      tax or investment advice. Speak to a qualified adviser about your own position.
    </p>
    <div class="mt-10">
      <a href="/insights" class="text-sm text-green-2 underline underline-offset-4">&larr; All insights</a>
    </div>
  </article>
  <CTABand />
</Base>
