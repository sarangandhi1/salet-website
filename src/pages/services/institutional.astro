---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
---
<Base
  title="For institutions | Salet"
  description="Salet works privately with institutional clients on deal sourcing, screening and analysis, and transaction advisory, under contract and under their frameworks."
>
  <PageHero
    eyebrow="Service 06 · By engagement"
    title="Institutional sourcing and transaction advisory"
    lede="Sourcing, screening and analysis for a small number of institutional clients, delivered privately under contract."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="prose-salet lg:col-span-7">
        <h2>What the practice covers</h2>
        <ul>
          <li><strong>Deal sourcing and screening.</strong></li>
          <li><strong>Analysis and packaging.</strong></li>
          <li><strong>Viewings and local verification.</strong></li>
          <li><strong>Transaction advisory.</strong></li>
        </ul>
        <h2>How it is engaged</h2>
        <p>
          Work runs under each client's own agreement. Mandates are never named publicly. Write to us directly.
        </p>
        <p>
          <a href="mailto:saran@salet.uk">saran@salet.uk</a>
        </p>
      </div>
      <aside class="lg:col-span-5">
        <div class="reveal border border-line bg-ivory-2/60 p-8 lg:p-10">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">Working principles</p>
          <ul class="mt-5 space-y-3.5 text-sm leading-relaxed text-stone">
            <li>Private delivery under contract</li>
            <li>Client confidentiality as standard</li>
            <li>The same analysis standards as private clients</li>
            <li>No public deal marketing of any kind</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CTABand invoice title="Discuss an institutional mandate" body="A direct conversation with the founder." />
</Base>
