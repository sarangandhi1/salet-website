---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';

const steps = [
  ['Exit strategy and research', 'Timing, target buyer profile, street-level pricing research from sold-price evidence, works worth doing before sale and works that would never pay back. Evidence first, then the decision.'],
  ['Agent selection', 'We shortlist estate agents on performance data, interview them with you or for you, and negotiate their terms before you sign. Your appointed agent markets the property and introduces buyers; that is their job, under their licence.'],
  ['Preparation', 'Presentation, paperwork and legal file assembled before listing, so the sale does not stall in week six on a missing document.'],
  ['Sale oversight', 'We stay on your side of the table while the agent runs the market: offers reviewed against the evidence, buyer credibility questioned, progression chased weekly. You receive one clear note, not a dozen calls.'],
  ['Completion and repatriation signposting', 'Completion handled; for overseas sellers we signpost the currency and reporting practicalities to raise with your advisers. We do not give tax advice.'],
];
---
<Base
  title="Sale advisory and managed sale | Salet"
  description="Selling UK property? Salet advises owners: pricing research, exit strategy, estate agent selection and sale oversight. Your appointed agent markets the property; Salet stays on your side."
>
  <PageHero
    eyebrow="Service 05 · Advisory live now"
    title="Sale advisory and managed sale"
    lede="Owners get the same discipline buyers get. We research your exit, help you choose and manage the right estate agent, and oversee the sale to completion. Your agent markets the property; Salet advises you."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-3xl font-medium leading-tight">How a managed sale runs</h2>
        <div class="mt-10 space-y-10">
          {
            steps.map(([title, body], i) => (
              <div class="reveal grid gap-4 border-l border-line pl-7 sm:grid-cols-12">
                <span class="font-display text-sm text-green-2 sm:col-span-2">0{i + 1}</span>
                <div class="sm:col-span-10">
                  <h3 class="font-display text-xl font-medium">{title}</h3>
                  <p class="mt-2.5 leading-relaxed text-stone">{body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <aside class="lg:col-span-5">
        <div class="reveal border border-line bg-ivory-2/60 p-8 lg:sticky lg:top-8 lg:p-10">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">Status</p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            Sale advisory and research support are available now. Full end to end sale management is offered as
            engagements allow, existing clients first.
          </p>
          <p class="mt-8 text-xs uppercase tracking-[0.24em] text-green-2">Who it is for</p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            Owners selling UK property, at home or from abroad, who want evidence and representation on their side
            before and after they appoint an estate agent.
          </p>
          <p class="mt-8 text-xs uppercase tracking-[0.24em] text-green-2">How we charge</p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            Advisory fee agreed in writing at engagement, discussed at discovery.
          </p>
          <p class="mt-8 text-xs uppercase tracking-[0.24em] text-green-2">The clean-roles principle</p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            Salet does not market your property, list it or introduce buyers to it; your appointed estate agent does
            that under their own licence. We advise you, and only you. Salet never acts for both sides of a
            transaction.
          </p>
          <a
            href="/contact"
            class="mt-9 inline-block w-full border border-green-2 bg-green px-6 py-4 text-center text-sm tracking-wide text-ivory transition-colors hover:bg-green-2"
          >
            Book a discovery call
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CTABand invoice
    title="Selling well starts before the agent"
    body="A 30 minute discovery call on your exit: what the evidence says about price and timing, and how to choose the agent who will actually earn their commission."
  />
</Base>
