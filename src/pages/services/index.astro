---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
---
<Base
  title="Services | Salet"
  description="The Salet service ladder: acquisition search and representation, end to end purchase concierge, management oversight, vacant property care, managed sale, and institutional work."
>
  <PageHero
    eyebrow="Services"
    title="One relationship, the whole property lifecycle"
    lede="The person who helps you buy also looks after what you bought."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-6 md:grid-cols-2">
      <ServiceCard
        href="/services/acquisition-search"
        number="01"
        title="Acquisition search and representation"
        body="A written brief, a whole-of-market search, viewings and negotiation, through to exchange."
      />
      <ServiceCard
        href="/services/purchase-concierge"
        number="02"
        title="End to end purchase concierge"
        body="The search, plus solicitors, brokers and everything live on completion day."
        delay="reveal-d1"
      />
      <ServiceCard
        href="/services/management-oversight"
        number="03"
        title="Management oversight"
        body="We supervise the letting agent. You deal with Salet only."
        status="coming"
      />
      <ServiceCard
        href="/services/vacant-property-care"
        number="04"
        title="Vacant property care"
        body="Inspections, keys, contractors and bills while your property stands empty."
        status="coming"
        delay="reveal-d1"
      />
      <ServiceCard
        href="/services/managed-sale"
        number="05"
        title="Sale advisory and managed sale"
        body="Pricing research, sale strategy and oversight of your estate agent."
      />
      <ServiceCard
        href="/services/institutional"
        number="06"
        title="For institutions"
        body="Deal sourcing and analysis, delivered privately under contract."
        delay="reveal-d1"
      />
    </div>

    <div class="reveal mt-16 border border-line bg-ivory-2/60 p-8 lg:p-10">
      <p class="max-w-3xl leading-relaxed text-stone">
        Fees: a retainer, deducted in full from a success fee due at exchange. Services marked coming open as our
        first clients complete.
      </p>
    </div>
  </section>

  <CTABand invoice />
</Base>
