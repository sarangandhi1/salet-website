---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Booking runs on the same Calendly account as sarangandhi.com (sarangandhi1), per Saran 5 Jul 2026.
// TODO (optional, later): create a Salet-branded "Discovery call" event type on that Calendly account
// and swap the URL here, so property bookings are labelled separately from consulting ones.
const CALENDLY_URL = 'https://calendly.com/sarangandhi1/30min';
---
<Base
  title="Book a Free Call with a UK Buying Agent | Salet"
  description="Book a free 30 minute discovery call with Salet: your situation, your brief and an honest view on whether buyer-only representation fits. Or write to saran@salet.uk."
>
  <PageHero
    eyebrow="Contact"
    title="Book a discovery call"
    lede="Thirty minutes, free, no obligation. Bring your brief however rough. India-based callers: evening slots in Indian time are available."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="reveal border border-line bg-ivory p-2">
          <div
            class="calendly-inline-widget"
            data-url={`${CALENDLY_URL}?hide_gdpr_banner=1&background_color=faf8f2&text_color=1b1a17&primary_color=2e5a40`}
            style="min-width:320px;height:700px;"
          >
          </div>
          <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
          <noscript>
            <p style="padding:1.5rem;">
              Book directly at
              <a href="https://calendly.com/sarangandhi1/30min">calendly.com/sarangandhi1/30min</a>
              or email <a href="mailto:saran@salet.uk">saran@salet.uk</a>.
            </p>
          </noscript>
        </div>
        <p class="reveal mt-4 text-xs leading-relaxed text-mist">
          Booking not loading? Go direct:
          <a href={CALENDLY_URL} class="text-green-2 underline underline-offset-4" rel="noopener" target="_blank">book the call here</a>,
          email <a href="mailto:saran@salet.uk" class="text-green-2 underline underline-offset-4">saran@salet.uk</a>,
          call <a href="tel:+447878781100" class="text-green-2 underline underline-offset-4">+44 7878 781100</a>
          or <a href="https://wa.me/447878781100" class="text-green-2 underline underline-offset-4" rel="noopener" target="_blank">WhatsApp us</a>.
        </p>

        <div class="reveal reveal-d1 mt-8 border border-line bg-ivory p-9 lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">What the call covers</p>
          <ul class="mt-6 space-y-4 text-sm leading-relaxed text-stone">
            <li><strong class="text-ink">Your situation.</strong> Where you are based, why you are buying, and when.</li>
            <li><strong class="text-ink">Your brief.</strong> What, where, budget and funding position.</li>
            <li><strong class="text-ink">The process.</strong> How Salet works and what buyer-only representation means.</li>
            <li><strong class="text-ink">The fees.</strong> Retainer and success fee, walked through openly with numbers.</li>
            <li><strong class="text-ink">Fit, honestly.</strong> A clear next step, or a straight answer that we are not the right firm for you.</li>
          </ul>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="reveal reveal-d1 border border-line bg-ivory-2/60 p-8 lg:p-10">
          <h2 class="font-display text-2xl font-medium leading-snug">Or write to us</h2>
          <form method="POST" action="https://formspree.io/f/mrewjydk" class="mt-7 space-y-4">
            <input type="hidden" name="form" value="contact" />
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-stone">Your name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="mt-2 w-full border border-line bg-ivory px-4 py-3.5 text-ink outline-none transition-colors focus:border-green-2"
              />
            </label>
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-stone">Email address</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="mt-2 w-full border border-line bg-ivory px-4 py-3.5 text-ink outline-none transition-colors focus:border-green-2"
              />
            </label>
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-stone">Where are you based?</span>
              <select
                name="based"
                class="mt-2 w-full border border-line bg-ivory px-4 py-3.5 text-ink outline-none transition-colors focus:border-green-2"
              >
                <option>United Kingdom</option>
                <option>India</option>
                <option>Elsewhere</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-stone">A line about your plans</span>
              <textarea
                name="message"
                rows="5"
                required
                class="mt-2 w-full border border-line bg-ivory px-4 py-3.5 text-ink outline-none transition-colors focus:border-green-2"
              ></textarea>
            </label>
            <button
              type="submit"
              class="w-full border border-green-2 bg-green px-6 py-4 text-sm tracking-wide text-ivory transition-colors hover:bg-green-2"
            >
              Send
            </button>
          </form>
          <p class="mt-5 text-xs leading-relaxed text-mist">
            Direct always works: <a href="mailto:saran@salet.uk" class="text-green-2">saran@salet.uk</a> ·
            <a href="tel:+447878781100" class="text-green-2">+44 7878 781100</a> ·
            <a href="https://wa.me/447878781100" class="text-green-2" rel="noopener" target="_blank">WhatsApp</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
