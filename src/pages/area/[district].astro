---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { faqSchema } from '../../lib/schema';
import {
  activity,
  allDistricts,
  areaName,
  asOfLong,
  asOfShort,
  compareDistricts,
  gbp,
  gbpShort,
  prices,
  slug,
  type District,
} from '../../lib/areas';

export function getStaticPaths() {
  return allDistricts.map((d) => ({ params: { district: slug(d.district) }, props: { d } }));
}

const { d } = Astro.props as { d: District };
const town = areaName(d.area);
const areaLabel = town === d.area ? d.area : `${d.area} (${town})`;
const busier = d.call === 'busier';
const total = d.sectors.length;

const answer = busier
  ? `Yes: more homes are coming to market here than in most of ${areaLabel}.`
  : `No: ${d.district} is quieter than most of ${areaLabel}, with fewer homes coming to market.`;

const sectorLine =
  total === 1
    ? `${d.district} has one postcode sector, and it is ${d.sectors[0].call} than most of ${d.area}.`
    : `${d.busier_sectors} of its ${total} postcode sectors ${d.busier_sectors === 1 ? 'is' : 'are'} busier than most of ${d.area}.`;

const sectors = [...d.sectors].sort((a, b) => a.sector.localeCompare(b.sector, 'en', { numeric: true }));
const neighbours = allDistricts
  .filter((x) => x.area === d.area && x.district !== d.district)
  .sort((a, b) => compareDistricts(a.district, b.district));

const strengthLabel = { strong: 'Strong', moderate: 'Moderate', weak: 'Weak' } as const;
const strengthDots = { strong: 3, moderate: 2, weak: 1 } as const;

// Sold prices (Land Registry). Some tiny or business-only districts have too
// few sales to say anything honest; for those the price section is left out.
const p = prices.districts[d.district];
const areaP = prices.areas[d.area];
const periodEnd = prices.period_end;
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};
const TYPE_LABEL = { detached: 'Detached', semi: 'Semi-detached', terraced: 'Terraced', flat: 'Flats' } as const;
const typeRows = p
  ? (Object.keys(TYPE_LABEL) as (keyof typeof TYPE_LABEL)[])
      .filter((k) => p.types[k])
      .map((k) => ({ key: k, label: TYPE_LABEL[k], ...p.types[k]! }))
  : [];
const biggest = [...typeRows].sort((a, b) => b.share_pct - a.share_pct)[0];

let changeLine = '';
if (p && p.median_change_pct !== null) {
  const c = p.median_change_pct;
  changeLine =
    Math.abs(c) < 1
      ? ', about the same as the year before'
      : `, ${Math.abs(c).toLocaleString('en-GB')}% ${c > 0 ? 'up on' : 'down on'} the year before`;
}
let areaLine = '';
if (p && areaP && d.area !== d.district) {
  const diff = Math.round(100 * (p.median / areaP.median - 1));
  const rank =
    p.rank_in_area && p.districts_in_area && p.districts_in_area > 1
      ? ` It is the ${ordinal(p.rank_in_area)} most expensive of ${p.districts_in_area} districts in ${d.area}.`
      : '';
  areaLine =
    Math.abs(diff) < 3
      ? `That is close to the typical price across ${areaLabel}, ${gbp(areaP.median)}.${rank}`
      : `That is ${Math.abs(diff)}% ${diff > 0 ? 'above' : 'below'} the typical price across ${areaLabel}, ${gbp(areaP.median)}.${rank}`;
}
const priceSummary = p
  ? `Homes in ${d.district} sold for a typical ${gbp(p.median)} in the 12 months to ${periodEnd}${changeLine}.`
  : '';
const faqs = p
  ? [
      {
        q: `How much does a house cost in ${d.district}?`,
        a: `${priceSummary} Half of all sales were between ${gbp(p.lower_quartile)} and ${gbp(p.upper_quartile)}.${
          typeRows.filter((t) => t.median).length
            ? ' By type: ' +
              typeRows
                .filter((t) => t.median)
                .map((t) => `${t.label.toLowerCase()} ${gbp(t.median!)}`)
                .join(', ') +
              '.'
            : ''
        }`,
      },
      {
        q: `Are more homes coming up for sale in ${d.district}?`,
        a: `${answer} ${sectorLine} Based on energy certificates lodged, updated ${asOfLong}.`,
      },
    ]
  : [];

const title = p
  ? `${d.district} house prices: ${gbpShort(p.median)} typical, ${busier ? 'busier' : 'quieter'} market | Salet`
  : `${d.district} housing market ${asOfShort}: busier or quieter? | Salet`;
const description = p
  ? `${d.district} ${town}: homes sold for a typical ${gbp(p.median)} in the 12 months to ${periodEnd}${changeLine}. Prices by property type, and whether more homes are coming to market. Updated monthly.`
  : busier
    ? `${d.district} ${town}: more homes coming to market than most of ${d.area}. ${d.busier_sectors} of ${total} postcode sectors busier. Area check, updated ${asOfLong}.`
    : `${d.district} ${town}: quieter than most of ${d.area}, fewer homes coming to market. ${d.busier_sectors} of ${total} postcode sectors busier. Area check, updated ${asOfLong}.`;

const REPORT_URL = 'https://reports.salet.uk/intelligence';
const SAMPLE_URL = 'https://reports.salet.uk/sample/intelligence';
---
<Base title={title} description={description} schema={faqs.length ? [faqSchema(faqs)] : []}>
  <PageHero eyebrow={`Area check · ${d.district} · ${town}`} title={p ? `${d.district} house prices and market activity` : `Is ${d.district} getting busier?`} compact>
    {p && (
      <p class="reveal reveal-d2 mt-7 max-w-2xl text-xl leading-relaxed text-ivory">
        Typical price <span class="font-display text-3xl font-medium">{gbp(p.median)}</span>
        <span class="block text-base text-mist">In the 12 months to {periodEnd}{changeLine}. Source: Land Registry.</span>
      </p>
    )}
    <p class="reveal reveal-d2 mt-7 max-w-2xl text-xl leading-relaxed text-ivory">
      <span class:list={['mr-2 inline-block px-2.5 py-0.5 text-sm font-medium uppercase tracking-wider', busier ? 'bg-green-2 text-ivory' : 'bg-ivory/15 text-ivory']}>
        {busier ? 'Busier' : 'Quieter'}
      </span>
      {answer}
    </p>
    <p class="reveal reveal-d2 mt-4 max-w-2xl text-base leading-relaxed text-mist">
      {sectorLine} Updated {asOfLong}.
    </p>
  </PageHero>

  {
    p && (
      <section class="mx-auto max-w-6xl px-6 pt-16 lg:px-8 lg:pt-20">
        <div class="max-w-3xl">
          <h2 class="font-display text-3xl font-medium">What homes sell for in {d.district}</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate">
            {priceSummary} Half of all sales were between {gbp(p.lower_quartile)} and {gbp(p.upper_quartile)}. {areaLine}
          </p>

          {typeRows.length > 0 && (
            <table class="mt-8 w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-ink/20 text-xs uppercase tracking-[0.18em] text-stone">
                  <th class="py-3 pr-4 font-medium">Type</th>
                  <th class="py-3 pr-4 font-medium">Share of sales</th>
                  <th class="py-3 font-medium">Typical price</th>
                </tr>
              </thead>
              <tbody>
                {typeRows.map((t) => (
                  <tr class="border-b border-line">
                    <td class="py-3 pr-4 font-medium">{t.label}</td>
                    <td class="py-3 pr-4 text-slate">{t.share_pct}% ({t.sales.toLocaleString('en-GB')} sales)</td>
                    <td class="py-3 text-slate">{t.median ? gbp(t.median) : 'Too few sales to say'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          <p class="mt-6 text-base leading-relaxed text-slate">
            {biggest && <>{biggest.key === 'flat' ? 'Flats' : `${biggest.label} homes`} made up the biggest share of sales ({biggest.share_pct}%). </>}
            {p.leasehold_pct}% of sales were leasehold and {p.new_build_pct}% were new build.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            The typical price is the median: half the homes sold for more, half for less. It moves with the mix of
            homes that sold, so a change does not mean every home in {d.district} is worth that much more or less.
            The figures for a single street can be very different, which is what the
            <a href={REPORT_URL} class="text-green-2 underline">report for one home</a> is for.
          </p>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h2 class="font-display text-3xl font-medium">Is {d.district} getting busier? Street by street: the postcode sectors in {d.district}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone">
          Each sector is ranked against every other sector in {areaLabel}. Busier means more homes
          to choose from over the next three to six months. Quieter means fewer. This is about how
          many homes come up for sale, not about prices.
        </p>

        <table class="mt-8 w-full border-collapse text-left text-sm">
          <thead class="hidden sm:table-header-group">
            <tr class="border-b border-ink/20 text-xs uppercase tracking-[0.18em] text-stone">
              <th class="py-3 pr-4 font-medium">Sector</th>
              <th class="py-3 pr-4 font-medium">Busier or quieter</th>
              <th class="py-3 pr-4 font-medium">What we see</th>
              <th class="py-3 font-medium">How clear</th>
            </tr>
          </thead>
          <tbody>
            {
              sectors.map((s) => (
                <tr class="block border-b border-line py-4 sm:table-row sm:py-0">
                  <td class="block font-display text-lg font-medium sm:table-cell sm:whitespace-nowrap sm:py-4 sm:pr-4 sm:align-top">
                    {s.sector}
                  </td>
                  <td class="mt-1 block sm:table-cell sm:py-4 sm:pr-4 sm:align-top">
                    <span
                      class:list={[
                        'inline-block px-2 py-0.5 text-xs font-medium uppercase tracking-wider',
                        s.call === 'busier' ? 'bg-green-2 text-ivory' : 'bg-ink/10 text-ink',
                      ]}
                    >
                      {s.call === 'busier' ? 'Busier' : 'Quieter'}
                    </span>
                  </td>
                  <td class="mt-2 block leading-relaxed text-slate sm:table-cell sm:py-4 sm:pr-4 sm:align-top">{s.sentence}</td>
                  <td class="mt-2 block sm:table-cell sm:whitespace-nowrap sm:py-4 sm:align-top">
                    <span class="inline-flex items-center gap-1.5 text-stone" title={`${strengthLabel[s.strength]}`}>
                      {[1, 2, 3].map((n) => (
                        <span
                          class:list={['inline-block h-2 w-2 rounded-full', n <= strengthDots[s.strength] ? 'bg-green-2' : 'bg-line']}
                          aria-hidden="true"
                        />
                      ))}
                      <span class="ml-1 text-xs">{strengthLabel[s.strength]}</span>
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="mt-10 border-l-2 border-green-2 pl-5 text-sm leading-relaxed text-stone">
          <p class="font-medium text-ink">How we know</p>
          <p class="mt-2">
            A home needs an energy certificate (EPC) before it can be sold or let. When more
            certificates are lodged in a sector than usual, more homes tend to come to market there
            in the months that follow. We count them every month for every postcode sector in
            England and rank each sector against the rest of its postcode area.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="border border-green-2 bg-ivory-2/60 p-8 lg:sticky lg:top-28">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">Looking at a home in {d.district}?</p>
          <p class="mt-4 font-display text-2xl font-medium leading-snug">
            Get the full report for a home here, £19
          </p>
          <p class="mt-4 text-sm leading-relaxed text-stone">
            The Salet report reads the evidence on one specific home, including how busy this area is,
            for its exact postcode sector, so you know where you stand before you offer.
          </p>
          <a
            href={REPORT_URL}
            class="btn-glow mt-6 block px-6 py-4 text-center text-base tracking-wide text-ivory"
          >
            Get the report, £19
          </a>
          <a href={SAMPLE_URL} class="mt-4 block text-center text-sm text-green-2 underline">
            See a sample report first
          </a>
        </div>
      </aside>
    </div>
  </section>

  {
    neighbours.length > 0 && (
      <section class="border-t border-line bg-ivory-2/40">
        <div class="mx-auto max-w-6xl px-6 py-14 lg:px-8">
          <h2 class="font-display text-2xl font-medium">Other districts in {areaLabel}</h2>
          <p class="mt-3 text-sm text-stone">
            <span class="mr-1 inline-block h-2 w-2 rounded-full bg-green-2" aria-hidden="true" /> busier than most of {d.area}
            <span class="ml-4 mr-1 inline-block h-2 w-2 rounded-full bg-mist" aria-hidden="true" /> quieter
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {neighbours.map((n) => (
              <li>
                <a
                  href={`/area/${slug(n.district)}`}
                  class="inline-flex items-center gap-2 border border-line bg-ivory px-3 py-2 text-sm transition-colors hover:border-green-2 hover:text-green-2"
                >
                  <span
                    class:list={['inline-block h-2 w-2 rounded-full', n.call === 'busier' ? 'bg-green-2' : 'bg-mist']}
                    aria-hidden="true"
                  />
                  {n.district}
                  <span class="sr-only">{n.call}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/area" class="mt-8 inline-block text-sm text-green-2 underline">Check another postcode</a>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-10 lg:px-8">
    <div class="max-w-3xl space-y-2 text-xs leading-relaxed text-stone">
      <p>Updated: {asOfLong}. Refreshed every month.</p>
      <p>Source: {activity.source}.</p>
      {p && <p>Sold prices: {prices.source}. Standard open-market sales only, {prices.period}.</p>}
      <p>How accurate is this? {activity.accuracy}</p>
      <p>This is a view on how many homes come to market. It says nothing about where prices will go.</p>
    </div>
  </section>
</Base>
