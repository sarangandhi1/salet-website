---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { activity, allDistricts, areaName, asOfLong, asOfShort, districtsByArea, slug } from '../../lib/areas';

const groups = districtsByArea();
const codes = allDistricts.map((d) => d.district);
---
<Base
  title={`Local housing market check, ${asOfShort}: is it busier? | Salet`}
  description={`Area check for every postcode district in England: are more homes coming to market here than in the rest of the postcode area? From energy certificate data, updated ${asOfLong}.`}
>
  <PageHero
    eyebrow="Area check"
    title="Is your area getting busier?"
    lede="Type a postcode or district. We show whether more homes are coming to market there than in the rest of its postcode area, sector by sector. Every postcode district in England, updated monthly."
    compact
  >
    <form id="area-search" class="reveal reveal-d2 mt-10 flex max-w-xl flex-col gap-3 sm:flex-row" role="search" data-codes={JSON.stringify(codes)}>
      <label for="area-q" class="sr-only">Postcode or district</label>
      <input
        id="area-q"
        name="q"
        type="text"
        autocomplete="postal-code"
        autocapitalize="characters"
        spellcheck="false"
        placeholder="e.g. CV5 6AB or B7"
        class="min-w-0 flex-1 border border-ivory/30 bg-ivory px-5 py-4 text-base text-ink placeholder:text-stone focus:border-green-3 focus:outline-none"
      />
      <button type="submit" class="bg-[#c2410c] px-8 py-4 text-base font-medium tracking-wide text-ivory transition-colors hover:bg-[#a8380a]">
        Check
      </button>
    </form>
    <p id="area-msg" class="mt-4 min-h-[1.5rem] max-w-xl text-sm text-ivory" role="status" aria-live="polite"></p>
  </PageHero>

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
    <h2 class="font-display text-3xl font-medium">All postcode districts</h2>
    <p class="mt-3 text-sm text-stone">
      <span class="mr-1 inline-block h-2 w-2 rounded-full bg-green-2" aria-hidden="true"></span> busier than most of its postcode area
      <span class="ml-4 mr-1 inline-block h-2 w-2 rounded-full bg-mist" aria-hidden="true"></span> quieter
    </p>

    <nav class="mt-8 flex flex-wrap gap-x-3 gap-y-2 text-sm" aria-label="Postcode areas">
      {groups.map(([area]) => <a href={`#area-${area.toLowerCase()}`} class="text-green-2 underline">{area}</a>)}
    </nav>

    <div class="mt-12 space-y-12">
      {
        groups.map(([area, list]) => (
          <div id={`area-${area.toLowerCase()}`} class="scroll-mt-28">
            <h3 class="border-b border-line pb-3 font-display text-xl font-medium">
              {area} <span class="text-stone">· {areaName(area)}</span>
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {list.map((d) => (
                <li>
                  <a
                    href={`/area/${slug(d.district)}`}
                    class="inline-flex items-center gap-2 border border-line bg-ivory px-3 py-1.5 text-sm transition-colors hover:border-green-2 hover:text-green-2"
                  >
                    <span
                      class:list={['inline-block h-2 w-2 rounded-full', d.call === 'busier' ? 'bg-green-2' : 'bg-mist']}
                      aria-hidden="true"
                    />
                    {d.district}
                    <span class="sr-only">{d.call}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-14 lg:px-8">
    <div class="max-w-3xl space-y-2 border-t border-line pt-8 text-xs leading-relaxed text-stone">
      <p>Updated: {asOfLong}. Refreshed every month.</p>
      <p>Source: {activity.source}.</p>
      <p>How accurate is this? {activity.accuracy}</p>
      <p>This is a call on how many homes come to market. It says nothing about where prices will go.</p>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('area-search') as HTMLFormElement;
  const input = document.getElementById('area-q') as HTMLInputElement;
  const msg = document.getElementById('area-msg')!;
  const codes = new Set<string>(JSON.parse(form.dataset.codes || '[]'));
  const areas = new Set([...codes].map((c) => c.match(/^[A-Z]+/)![0]));

  // Accepts a full postcode ("CV5 6AB"), a district ("cv5"), a sector
  // ("CV5 6") or a postcode area ("CV"). All matching happens here, in the
  // browser: nothing typed is sent anywhere.
  function resolve(raw: string): { district?: string; area?: string } {
    const q = raw.toUpperCase().replace(/[^A-Z0-9 ]/g, '').trim();
    if (!q) return {};
    const first = q.split(/\s+/)[0];
    if (codes.has(first)) return { district: first };
    const compact = q.replace(/\s+/g, '');
    if (codes.has(compact)) return { district: compact };
    // Full postcode typed without a space: the inward code is always 3 chars.
    if (compact.length >= 5 && codes.has(compact.slice(0, -3))) return { district: compact.slice(0, -3) };
    // Sector typed without a space, e.g. "CV56".
    if (compact.length >= 3 && codes.has(compact.slice(0, -1))) return { district: compact.slice(0, -1) };
    if (areas.has(compact)) return { area: compact };
    return {};
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const { district, area } = resolve(input.value);
    if (district) {
      location.href = `/area/${district.toLowerCase()}`;
    } else if (area) {
      msg.textContent = '';
      location.hash = `area-${area.toLowerCase()}`;
    } else if (input.value.trim()) {
      msg.textContent =
        'We could not find that postcode. Try the first half, like CV5 or B7. We cover England only for now.';
    }
  });
</script>
