---
import Base from '../layouts/Base.astro';
import { INTEL_FEATURES, bySlug } from '../data/reports';
import { OFFER_EXPLAINER, faqSchema, productSchema } from '../lib/schema';
import CardPay from '../components/CardPay.astro';
import StartBox from '../components/StartBox.astro';

// Ad landing page for the £19 property report. Deliberately not in the main
// nav: paid traffic lands here and the page has one job, which is to get a
// stranger from "is this house worth it?" to the order page. No consulting
// pitch above the fold, and the hero carries no reveal animation so the
// button is on screen the moment the page paints on a phone.
//
// The postcode box sends the address straight to the report form on
// reports.salet.uk, which fills it in from the link (StartBox).
const REPORT_URL = 'https://salet.uk/intelligence';
const SAMPLE_URL = 'https://salet.uk/sample/intelligence';
const PRICE = '£19';

// What you get, as tiles: each a crop of the live sample report section it
// describes, with one line on what it tells you.
const tiles = INTEL_FEATURES.slice(0, 9);

const faqs = [
  {
    q: 'How fast is it?',
    a: 'Minutes. Pay, and the report usually lands in a minute or two, in your account and in your inbox.',
  },
  {
    q: 'What if there is no data for my address?',
    a: 'Where a source has nothing for an address, the report says so rather than leaving it out. If a report fails to run, or comes back with no data, we refund it in full.',
  },
  {
    q: 'Can I get a refund?',
    a: 'Yes. Not useful? Full refund, no questions: ask within 30 days of paying and we refund the full amount, with no reason needed. A credit you have not used can also be cancelled within 14 days, and a report that fails to run or comes back with no data is refunded in full.',
    link: { href: 'https://salet.uk/terms#refunds', label: 'Read the refund terms' },
  },
  {
    q: 'Is my data shared?',
    a: 'No. We do not sell your data and we do not share it with anyone else.',
    link: { href: 'https://salet.uk/privacy', label: 'Privacy notice' },
  },
  {
    q: 'Do I need an account?',
    a: 'No password and no sign-up page. You give your email with the address, and your report link and receipt go there.',
  },
];
---
<Base
  title="Is this house overpriced? House price check, £19 | Salet"
  description="Check any house in England before you offer: sold prices on the street, stamp duty, rent, flood, crime and schools. Basic report £9, full report £19."
  schema={[
    productSchema(bySlug('buyer-intelligence'), 'https://salet.uk/check/', 'What every home nearby really sold for, your stamp duty, rent, flood risk, crime, planning and schools for one address in England. Full report £19, 30-day full refund.'),
    faqSchema([{ q: OFFER_EXPLAINER.heading, a: OFFER_EXPLAINER.answer }, ...OFFER_EXPLAINER.faqs, ...faqs]),
  ]}
>
  <section class="relative overflow-hidden bg-ink pb-14 pt-28 text-ivory sm:pb-20 sm:pt-36">
    <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
      <p class="text-xs uppercase tracking-[0.28em] text-green-3">Salet property report</p>
      <h1 class="mt-4 max-w-3xl font-display text-[2.15rem] font-medium leading-[1.08] sm:text-5xl lg:text-6xl">
        Is this house worth the asking price?
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ivory/80 sm:text-lg">
        Never overpay again. See what every home nearby really sold for, your stamp duty, rent,
        flood risk, crime, planning and schools. One address, ready in minutes.
      </p>

      <StartBox button="Check this property" />
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <p class="leading-tight">
          <span class="font-display text-4xl font-medium">{PRICE}</span>
        </p>
      </div>
      <p class="mt-4 text-sm text-ivory/80">
        <strong class="font-medium text-ivory">Or the Basic report for £9.</strong> Not useful? Full refund within 30 days, no questions.
      </p>
      <CardPay tone="dark" align="start" />
      <p class="mt-5 text-sm">
        <a href={SAMPLE_URL} class="text-green-3 underline underline-offset-4 hover:text-ivory">See a full sample report</a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-14 lg:px-8 lg:py-20">
    <p class="text-xs uppercase tracking-[0.24em] text-green-2">From the sample report</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      What you get for {PRICE}
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiles.map((t) => (
          <figure class="border border-line bg-white">
            <a href={SAMPLE_URL} class="block aspect-[4/3] overflow-hidden border-b border-line bg-[#f4f8fc]" tabindex="-1">
              <img src={t.img} width="800" height="600" alt={`Sample report section: ${t.title}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
            </a>
            <figcaption class="px-5 pb-5 pt-4">
              <strong class="block text-base font-medium text-ink">{t.title}</strong>
              <span class="mt-1 block text-sm leading-relaxed text-stone">{t.line}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-8 text-sm">
      Plus who lives around here, what has sold at the address and licensed shared housing nearby.
      Every figure dated and sourced, with a PDF copy by email.
      <a href={SAMPLE_URL} class="text-green-2 underline underline-offset-4">See a full sample report</a>
    </p>
  </section>

  <section class="border-y border-line bg-ivory-2/60">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-14 lg:grid-cols-12 lg:px-8 lg:py-20">
      <div class="lg:col-span-7">
        <h2 class="font-display text-3xl font-medium leading-tight">Built on 30 years of Land Registry sales</h2>
        <p class="mt-5 text-base leading-relaxed text-stone">
          Every home in England covered, and more than 2,000 areas tracked every month. We bring
          together the Land Registry, the EPC register, ONS, the Environment Agency and local planning
          records, so you see everything the agent already knows.
        </p>
        <p class="mt-8 border-l-2 border-green-2 pl-4 text-sm font-medium leading-relaxed text-ink">
          Not useful? Full refund, no questions.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="border border-line bg-ivory p-7 sm:p-9">
          <h2 class="font-display text-2xl font-medium">How it works</h2>
          <ol class="mt-6 space-y-5 text-sm leading-relaxed text-stone">
            <li><strong class="text-ink">1. Enter the postcode.</strong> And the house number if you have it. Your account keeps your reports together.</li>
            <li><strong class="text-ink">2. Pick Basic or full.</strong> The Basic report (£9) is the public record: the energy certificate and floor area, every Land Registry sale at the address and in the postcode, the neighbourhood type and local rents. The full report ({PRICE}) adds the price range, every comparable sale, stamp duty, flood, crime, planning and schools.</li>
            <li><strong class="text-ink">3. Pay and read it.</strong> Ready in a minute or two, with a PDF by email. Started with Basic? Upgrade to full for £10.</li>
          </ol>
          <a
            href={REPORT_URL}
            class="ck-cta mt-8 flex items-center justify-center bg-[#c2410c] px-6 py-4 text-base font-medium text-ivory transition-colors duration-200 hover:bg-[#a6370a]"
          >
            Check this home
          </a>
          <p class="mt-3 text-center text-xs text-stone">Basic £9, full report {PRICE}. No subscription.</p>
          <CardPay />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pt-14 lg:px-8 lg:pt-20" id="how-much-to-offer">
    <h2 class="font-display text-3xl font-medium leading-tight">{OFFER_EXPLAINER.heading}</h2>
    <p class="mt-5 text-base leading-relaxed text-stone">{OFFER_EXPLAINER.answer}</p>
    <div class="mt-8 space-y-6">
      {
        OFFER_EXPLAINER.faqs.map((f) => (
          <div>
            <h3 class="text-lg font-medium text-ink">{f.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-14 lg:px-8 lg:py-20">
    <h2 class="font-display text-3xl font-medium leading-tight">Questions</h2>
    <div class="mt-7 divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink">
              {f.q}
              <span class="text-xl leading-none text-green-2 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone">
              {f.a}
              {f.link && (
                <>
                  {' '}
                  <a href={f.link.href} class="text-green-2 underline underline-offset-2">{f.link.label}</a>.
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="bg-ink text-ivory">
    <div class="mx-auto max-w-6xl px-6 py-14 text-center lg:px-8 lg:py-16">
      <h2 class="font-display text-3xl font-medium leading-tight sm:text-4xl">Check the house before you offer</h2>
      <a
        href={REPORT_URL}
        class="ck-cta mt-7 inline-flex items-center justify-center bg-[#c2410c] px-8 py-4 text-lg font-medium text-ivory transition-colors duration-200 hover:bg-[#a6370a]"
      >
        Check a property
      </a>
      <p class="mt-4 text-sm text-ivory/75">Basic £9 or full {PRICE}. Full refund within 30 days if not useful.</p>
      <CardPay tone="dark" />
    </div>
  </section>

  <p class="mx-auto max-w-6xl px-6 py-8 text-center text-sm text-stone lg:px-8">
    Want someone to negotiate for you? Salet also acts as your
    <a href="/services" class="text-green-2 underline underline-offset-2">buying agent</a>.
  </p>
</Base>

<style>
  /* Thumb sized on a phone: the main button fills the row. */
  @media (max-width: 30rem) {
    .ck-cta { width: 100%; }
  }
</style>
