---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

// The widget is served by Salet's deal-check service, which combines the same
// two engines that run our internal underwriting: the sold-price valuation and
// the deterministic refurb cost book. It wears the site palette via query
// params, exactly like the price and refurb embeds.
const WIDGET_URL =
  'https://dealforge-2fkp.onrender.com/deal-widget?primary=2e5a40&accent=2e5a40&bg=f2eee4&btn=C2410C';

// WhatsApp destination for the photo estimate, the page's conversion goal.
const WA_LINK = 'https://wa.me/447878781100';
---
<Base
  title="What should I offer? | Free doer-upper offer calculator | Salet"
  description="For a home that needs work. We value it from recent sold prices, cost the refurb from our standing cost book, and take the work off the value to suggest an opening offer. The full breakdown lands in your inbox."
>
  <PageHero
    eyebrow="Free offer check"
    title="What should I offer on a doer-upper?"
    lede="Weighing up a place that needs work. We value it from recent sold prices nearby, cost the work from our standing cost book, and take the work off the value to suggest an opening offer. Evidence first, no charge, and no valuation."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="reveal border border-line bg-ivory p-2">
          <iframe
            src={WIDGET_URL}
            title="Salet offer check"
            style="width:100%;height:1560px;border:0;display:block;background:#ffffff;"
            loading="lazy"
          ></iframe>
        </div>
        <p class="reveal mt-4 text-xs leading-relaxed text-mist">
          An indicative opening offer from recent sold prices and our standing cost book, not a
          valuation. Every home is different, which is why we offer the photo estimate. Five free
          checks per day.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="reveal border border-line bg-ivory p-9 lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">How it works</p>
          <ul class="mt-6 space-y-4 text-sm leading-relaxed text-stone">
            <li>
              <strong class="text-ink">1. We value the home.</strong> From recent sold prices near
              the postcode, sized to this home when you give the house number, we read the floor area
              from its EPC record.
            </li>
            <li>
              <strong class="text-ink">2. We cost the work.</strong> Tick what it needs and we price
              it from our standing cost book, the same figures we use when we underwrite a purchase.
            </li>
            <li>
              <strong class="text-ink">3. We take the work off the value.</strong> The higher refurb
              figure comes off the lower end of the value, and that is your suggested opening offer.
              No buffers, no padding, just the arithmetic.
            </li>
          </ul>
        </div>

        <div class="reveal reveal-d1 mt-8 border border-line bg-ivory-2/60 p-9 lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">Why we give this away</p>
          <p class="mt-5 text-sm leading-relaxed text-stone">
            Because the offer on a project home is where buyers get caught out, paying today for work
            they will pay for again tomorrow. It shows how we work: evidence first, always on the
            buyer's side. When you want a firm figure for a specific home, send us three to five
            photos and we will send a proper eyes-on estimate back.
          </p>
          <a
            href={WA_LINK}
            class="mt-6 inline-block bg-[#c2410c] px-6 py-3 text-sm font-medium tracking-wide text-white transition-all duration-200 hover:bg-[#e0763a]"
          >
            WhatsApp us your photos
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
