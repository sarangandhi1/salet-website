---
import Base from '../layouts/Base.astro';
import AudienceChooser from '../components/AudienceChooser.astro';
import { SALET_AUDIENCE_LINKS } from '../lib/sites';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
---
<Base
  title="Check any house before you offer: property reports for England | Salet"
  description="Property reports for any house in England: the price sold homes support, stamp duty, rent, flood, crime, planning and schools. Basic report £9, full report £19, 30-day refund. Or a buyer-only agent to do it all."
>
  <!-- Hero: "Which one are you?" Every kind of visitor sees their category
       first. The buying-agent message sits right under the chooser. -->
  <section id="home-white" class="relative overflow-hidden bg-white text-ink">


    <div class="relative mx-auto w-full max-w-6xl px-4 pb-12 pt-24 sm:px-6 lg:px-8 lg:pb-14 lg:pt-[4.5rem]">
      <!-- The report leads: it is what Salet sells most and what answer
           engines should say Salet is. The buying agent follows below. -->
      <!-- Video banner: a silent looping street-to-front-door clip behind the
           report pitch. The poster shows until it plays; reduced-motion users
           keep the still. -->
      <div class="hero-film relative mb-4 overflow-hidden rounded-[28px]">
        <video
          class="absolute inset-0 h-full w-full object-cover"
          src="/video/hero.mp4"
          poster="/video/hero-poster.webp"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
        <div class="absolute inset-0 bg-gradient-to-r from-ink/85 via-ink/55 to-ink/10" aria-hidden="true"></div>
        <div class="relative max-w-4xl px-6 py-8 sm:px-10 sm:py-10 lg:px-12 lg:py-7">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#86b0dc]">Property reports for England &middot; From &pound;9</p>
        <h1 class="mt-2 font-display text-3xl font-medium leading-[1.08] text-white sm:text-[2.5rem]">Check any house before you offer.</h1>
        <p class="mt-2 max-w-3xl text-[0.95rem] leading-relaxed text-ivory/90">
          Put in the address. See the price recent sold homes support, the stamp duty you would pay, what it lets for,
          and the flood, crime, planning and schools around it. The Basic report is &pound;9. The full report is &pound;19.
          Not useful? Full refund within 30 days.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <a href="https://salet.uk/intelligence" class="inline-flex items-center gap-2 bg-[#c2410c] px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-[#a6370a]">Check a property <span aria-hidden="true">&rarr;</span></a>
          <a href="https://salet.uk/compare-homes" data-track="hero:compare-homes" class="inline-flex items-center gap-2 border border-ivory/50 px-5 py-3 text-base font-semibold text-white transition-colors hover:border-ivory hover:bg-white/5"><span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#c8a95e]">New</span> Compare 2 or more homes <span aria-hidden="true">&rarr;</span></a>
          <a href="https://salet.uk/sample/intelligence" class="text-sm text-[#86b0dc] underline underline-offset-4 hover:text-ivory">See a real report</a>
        </div>
        </div>
      </div>
      <a href="/brief" class="group mb-4 flex flex-col gap-3 border border-[#c8a95e] bg-[#fbf7ec] p-4 transition-colors hover:border-[#c8a95e] hover:bg-[#f6efdc] sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-3">
        <span class="block">
          <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-[#8a6d1f]">Looking for a home?</span>
          <span class="mt-0.5 block font-display text-xl font-medium leading-snug text-ink">Tell us the home you want. We take it from there.</span>
          <span class="mt-1 block text-sm text-stone lg:hidden">60 seconds: tap your answers, type or leave a voice note. Saran replies within one working day.</span>
        </span>
        <span class="inline-flex shrink-0 items-center justify-center gap-2 bg-[#c2410c] px-5 py-2.5 text-base font-semibold text-white transition-colors group-hover:bg-[#a6370a]">Find my home <span aria-hidden="true">&rarr;</span></span>
      </a>
      <AudienceChooser items={SALET_AUDIENCE_LINKS} tone="light" />
      <div class="mt-10 flex flex-col items-center gap-5 text-center sm:mt-12">
        <p class="max-w-3xl font-display text-2xl font-medium leading-snug text-ink sm:text-3xl">
          Want someone to do it all for you? Salet is a UK buying agent that acts <span class="text-green-2">only for you.</span>
        </p>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href="/contact" class="btn-glow group inline-flex items-center gap-4 px-8 py-4 text-base tracking-wide text-ivory">
            Book a discovery call
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/brief" class="inline-flex items-center gap-3 border border-ink/30 px-7 py-4 text-base tracking-wide text-ink transition-colors hover:border-ink hover:bg-ink/5">
            Find my home
          </a>
          <a href="/how-we-work" class="link-line text-sm tracking-wide text-stone hover:text-ink">See how we work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Compare Homes: the marquee feature (5 Nov 2026). Up to five homes side
       by side, the best buy named first; ordered on reports.salet.uk. -->
  <section id="compare-homes" class="border-b border-line bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-20">
      <a href="https://salet.uk/compare-homes" class="block border border-line bg-white" aria-label="Compare Homes">
        <img src="/images/art/five-pack-800.webp" srcset="/images/art/five-pack-800.webp 800w, /images/art/five-pack-1168.webp 1168w" sizes="(min-width: 1024px) 560px, 100vw" alt="Five homes side by side" width="800" height="603" loading="eager" class="block h-auto w-full" />
      </a>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c2410c]">New &middot; Compare Homes &middot; £28</p>
        <h2 class="mt-3 font-display text-3xl font-medium leading-[1.1] text-ink sm:text-5xl">Compare 2 or more of your home choices.</h2>
        <p class="mt-5 text-lg leading-relaxed text-stone">Torn between a few homes? Put up to five side by side on the same sold evidence. We name the one priced best against what similar homes really sold for, and tell you what to ask the agent about each.</p>
        <ul class="mt-6 space-y-3 border-t border-line pt-6 text-base text-ink">
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2410c]"></span>Every home priced against its own sold evidence, best first</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2410c]"></span>Tenure, last sale, energy rating, stamp duty, flood risk and schools for each</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2410c]"></span>The questions to ask before you book a viewing</li>
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href="https://salet.uk/compare-homes" data-track="home:compare-homes" class="inline-flex items-center gap-2 bg-[#c2410c] px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-[#a6370a]">Compare my homes <span aria-hidden="true">&rarr;</span></a>
          <span class="text-sm text-stone">£28 for up to five homes. One payment, nothing renews.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <section class="overflow-hidden border-y border-line bg-white py-5" aria-hidden="true">
    <div class="marquee gap-14 whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center gap-14 pr-14">
            {[
              'London', 'Birmingham', 'Coventry', 'Warwick', 'Leamington Spa', 'Canary Wharf',
              'Manchester', 'Solihull', 'Stratford-upon-Avon', 'Buyer-only representation', 'Search', 'Analysis',
              'Negotiation', 'Completion', 'Beyond the keys',
            ].map((word) => (
              <span class="flex items-center gap-14 font-display text-lg text-stone">
                {word}
                <span class="h-1 w-1 rounded-full bg-green-2/60" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- The Buyer Intelligence Report: the flagship product, in the prime slot.
       The three quick calculator tools that used to follow it were retired
       on 10 Nov 2026: every product is now paid for before it runs. -->
  <section id="buyer-intelligence" class="relative overflow-hidden bg-[#f5f7fa] text-ink">


    <div class="relative mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <p class="reveal text-xs uppercase tracking-[0.28em] text-[#1f437c]">
        What should I know about this property? &middot; Basic &pound;9 or full &pound;19
      </p>
      <h2 class="reveal reveal-d1 mt-4 max-w-3xl font-display text-4xl font-medium leading-[1.05] sm:text-5xl">
        Everything the evidence says about a UK property, in one report.
      </h2>
      <p class="reveal reveal-d2 mt-6 max-w-3xl text-lg leading-relaxed text-ink-3">
        Put in an address. Get back what recent sold prices support as a range, the comparable sales
        behind it, the stamp duty you would actually pay, the official energy certificate, what it
        lets for locally, and the area around it: planning applications, flood risk, crime by
        offence, named schools and licensed shared housing nearby.
      </p>

      <div class="reveal reveal-d2 mt-10 grid gap-x-10 gap-y-5 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-3">
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Every figure is a range.</strong> Never a single
          number pretending to be certain.
        </p>
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Every block names its source</strong> and the date
          it was pulled.
        </p>
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Rent from actual local lettings</strong>, not a
          whole-city average that says nothing about the street.
        </p>
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Stamp duty on both bases</strong>, as your only
          home and as an additional dwelling.
        </p>
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Like-for-like sales</strong>, the true peers by
          type and size, as a cross-check.
        </p>
        <p class="border-l-2 border-[#1f437c] pl-4 text-sm leading-relaxed text-ink-3">
          <strong class="font-medium text-ink">Where a source returns nothing</strong>, the report
          says so rather than leaving it out.
        </p>
      </div>

      <div class="reveal reveal-d3 mt-10 flex flex-wrap items-center gap-5">
        <a
          href="https://salet.uk/intelligence"
          class="inline-block bg-[#c2410c] px-8 py-4 text-base font-medium tracking-wide text-white transition-all duration-200 hover:bg-[#e0763a]"
        >
          Run a report on any address &rarr;
        </a>
        <a href="https://salet.uk/sample/intelligence" class="text-sm text-[#1f437c] underline underline-offset-4 hover:text-ink">
          Read a full sample report first
        </a>
      </div>
    </div>
  </section>

  <!-- Dual audience entry paths -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">Two starting points</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      Where are you buying from?
    </h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <a href="/for-uk-nris" class="reveal-scale group relative flex min-h-[30rem] items-end overflow-hidden">
        <img
          src="/images/hero-street.webp"
          alt="Georgian terrace street in London at dusk, warm lights in the windows"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1400"
          height="939"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent transition-opacity duration-500 group-hover:opacity-95"></div>
        <div class="relative p-9 text-ivory lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">You live in the UK</p>
          <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
            Buying here, wanting the process handled properly
          </h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-ivory/80">
            First purchase or fifth, the process does not get friendlier: leasehold, gazumping, chains, surveys, and
            an agent who works for the seller. Many of our clients came to the UK before buying in it, NRIs among
            them, and we level the field for all of them.
          </p>
          <span class="link-line mt-7 inline-flex items-center gap-2 text-sm text-green-3">
            Start here
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
              >&rarr;</span
            >
          </span>
        </div>
      </a>
      <a href="/for-india-hnis" class="reveal-scale group relative flex min-h-[30rem] items-end overflow-hidden">
        <img
          src="/images/skyline.webp"
          alt="London skyline across the Thames at dusk"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1400"
          height="939"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent transition-opacity duration-500 group-hover:opacity-95"></div>
        <div class="relative p-9 text-ivory lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">You live abroad</p>
          <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
            Buying in the UK from thousands of miles away
          </h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-ivory/80">
            A child at university, a future move, or a sterling asset. Wherever home is right now, the question is
            trust: who views, who verifies, who negotiates, who holds the keys. That is precisely what we do.
          </p>
          <span class="link-line mt-7 inline-flex items-center gap-2 text-sm text-green-3">
            Start here
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
              >&rarr;</span
            >
          </span>
        </div>
      </a>
    </div>
    <a
      href="/services/managed-sale"
      class="reveal group mt-6 flex flex-wrap items-center justify-between gap-4 border border-line bg-white px-10 py-7 transition-all duration-300 hover:border-green-2/50"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-stone">
        <span class="font-display text-base font-medium text-ink">Selling a property?</span>
        &nbsp;We advise owners too: pricing research, agent selection and sale oversight, with your appointed agent
        doing the marketing.
      </p>
      <span class="inline-flex items-center gap-2 text-sm text-green-2">
        Sale advisory
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </span>
    </a>
  </section>

  <!-- Service pillars -->
  <section class="bg-[#f5f7fa]">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">What we do</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-xl font-display text-3xl font-medium leading-tight sm:text-4xl">
            One relationship, the whole property lifecycle
          </h2>
        </div>
        <a href="/services" class="reveal reveal-d2 text-sm text-green-2 underline underline-offset-4">All services</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <ServiceCard
          href="/services/acquisition-search"
          number="01"
          title="Acquisition search and representation"
          body="A written brief, a full market search including off-market homes, institutional-grade analysis of every candidate, and negotiation by someone on your side of the table."
        />
        <ServiceCard
          href="/services/purchase-concierge"
          number="02"
          title="End to end purchase concierge"
          body="Solicitors chased, introductions made, paperwork signposted, utilities live on completion day. One accountable point of contact from offer to keys."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/management-oversight"
          number="03"
          title="Management oversight"
          body="After completion we appoint and supervise the letting agent, review every statement and inspect the property, so ownership from abroad feels like ownership from nearby."
          status="coming"
          delay="reveal-d2"
        />
        <ServiceCard
          href="/services/vacant-property-care"
          number="04"
          title="Vacant property care"
          body="Regular inspections with photo reports, key-holding, a vetted contractor network, and bills and mail handled while your property stands empty."
          status="coming"
        />
        <ServiceCard
          href="/services/managed-sale"
          number="05"
          title="Sale advisory and managed sale"
          body="Sellers get the same discipline: pricing research, exit strategy, estate agent selection and sale oversight. Your agent markets the property; Salet advises you."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/institutional"
          number="06"
          title="For institutions"
          body="Deal sourcing, screening and analysis for institutional clients, delivered privately under contract. A separate practice with the same standards."
          delay="reveal-d2"
        />
      </div>
    </div>
  </section>

  <!-- The whole market: traditional and modern -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">The whole market</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      Traditional or modern, the discipline is the same
    </h2>
    <p class="reveal reveal-d2 mt-5 max-w-2xl leading-relaxed text-stone">
      Georgian terraces, Canary Wharf glass, Manchester's new skyline. We judge property by evidence, not by era,
      and represent buyers across the whole of the UK market.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <figure class="reveal-scale group relative overflow-hidden">
        <img
          src="/images/cottage.webp"
          alt="English stone cottage with a lush green garden in summer sunshine"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Cottages and countryside</p>
          <p class="mt-1.5 font-display text-lg font-medium">Period charm, bought with a cool head</p>
        </figcaption>
      </figure>
      <figure class="reveal-scale group relative overflow-hidden md:translate-y-8">
        <img
          src="/images/canary-wharf.webp"
          alt="Canary Wharf glass towers at dusk"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Canary Wharf</p>
          <p class="mt-1.5 font-display text-lg font-medium">Towers, read building by building</p>
        </figcaption>
      </figure>
      <figure class="reveal-scale group relative overflow-hidden">
        <img
          src="/images/manchester.webp"
          alt="Central Manchester modern skyline at dusk"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Central Manchester</p>
          <p class="mt-1.5 font-display text-lg font-medium">The new skyline, priced on evidence</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Buyer-only principle -->
  <section class="relative overflow-hidden bg-green text-ivory">
    <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-3">The principle</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-3xl font-medium leading-tight sm:text-5xl">
            One side of the table, <span class="grad-text">always yours.</span>
          </h2>
          <p class="reveal reveal-d2 mt-6 max-w-xl leading-relaxed text-ivory/80">
            In every purchase we act only for the buyer: no listings, no marketing mandates, no referral payments
            that would compromise the advice you receive. When owners engage us to sell, the roles stay just as
            clean: we advise you and oversee your appointed estate agent, who markets the property. Salet never acts
            for both sides of a transaction.
          </p>
          <div class="reveal reveal-d3 mt-8">
            <a href="/why-salet" class="link-line inline-flex items-center gap-2 text-sm text-green-3 hover:text-ivory">
              Why that matters &rarr;
            </a>
          </div>
        </div>
        <div class="reveal-scale lg:col-span-5">
          <div class="floaty relative overflow-hidden shadow-[0_40px_90px_-30px_rgba(0,0,0,0.6)]">
            <img
              src="/images/green-door.webp"
              alt="Deep green London townhouse door with brass hardware"
              class="h-full w-full object-cover"
              loading="lazy"
              width="1400"
              height="1045"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works, condensed -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">The journey</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      From first call to keys in hand
    </h2>
    <div class="mt-14 grid gap-10 md:grid-cols-4">
      {
        [
          ['Discovery', 'A 30 minute call. Your situation, your brief, and whether we are the right fit. Honest both ways.'],
          ['Search', 'We shortlist areas, search the whole market including off-market homes, and analyse every candidate before you see it.'],
          ['Negotiation', 'We attend viewings for you or with you, verify what agents claim, and negotiate as your sole representative.'],
          ['Completion and beyond', 'Solicitors chased, completion handled, keys held. Then oversight, care and eventually the sale, if you want us to stay.'],
        ].map(([title, body], i) => (
