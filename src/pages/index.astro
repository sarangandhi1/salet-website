---
import Base from '../layouts/Base.astro';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialSlot from '../components/TestimonialSlot.astro';
---
<Base
  title="Salet | The buyer-only UK property concierge"
  description="Buyer-only representation and end to end property concierge for UK home buyers and overseas buyers, with particular fluency for clients buying from India. Salet acts only for you."
>
  <!-- Hero -->
  <section class="relative flex min-h-[100svh] items-end overflow-hidden bg-ink text-ivory">
    <div class="absolute inset-0" aria-hidden="true">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/hero-bright-mobile.webp" />
        <img
          src="/images/hero-bright.webp"
          alt=""
          class="h-full w-full object-cover"
          fetchpriority="high"
          width="2200"
          height="942"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-ink/10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/25 to-transparent"></div>
      <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-ink/75 to-transparent"></div>
    </div>
    <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-6 pb-20 pt-48 lg:px-8 lg:pb-24">
      <p class="reveal text-xs uppercase tracking-[0.32em] text-green-3">Property concierge · United Kingdom</p>
      <h1
        class="word-reveal text-glow mt-6 max-w-4xl font-display text-5xl font-medium leading-[1.03] text-white sm:text-6xl lg:text-[5.25rem]"
      >
        <span class="w" style="animation-delay:0.05s">Buy</span>
        <span class="w" style="animation-delay:0.13s">UK</span>
        <span class="w" style="animation-delay:0.21s">property</span>
        <span class="w" style="animation-delay:0.29s">with</span>
        <span class="w" style="animation-delay:0.37s">someone</span>
        <span class="w" style="animation-delay:0.45s">who</span>
        <span class="w" style="animation-delay:0.53s">acts</span>
        <span class="w grad-text" style="animation-delay:0.63s">only</span>
        <span class="w grad-text" style="animation-delay:0.71s">for</span>
        <span class="w grad-text" style="animation-delay:0.79s">you.</span>
      </h1>
      <p class="reveal reveal-d3 text-glow mt-8 max-w-2xl text-lg leading-relaxed text-white/95">
        Salet is a buyer-only property concierge. We search, analyse, negotiate and manage the entire purchase, then
        look after what you own. We work for buyers across the UK, at home and overseas. The seller has an agent.
        Now you do too.
      </p>
      <div class="reveal reveal-d4 mt-11 flex flex-wrap items-center gap-7">
        <a
          href="/contact"
          class="btn-glow group inline-flex items-center gap-4 px-9 py-5 text-base tracking-wide text-ivory"
        >
          Book a discovery call
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
            >&rarr;</span
          >
        </a>
        <a href="/how-we-work" class="link-line text-sm tracking-wide text-ivory/80 hover:text-ivory">
          See how we work
        </a>
      </div>
      <div class="scroll-cue mt-14 hidden w-6 text-center text-[0.6rem] uppercase tracking-[0.25em] text-mist lg:block">
        Scroll
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <section class="overflow-hidden border-y border-line bg-ivory py-5" aria-hidden="true">
    <div class="marquee gap-14 whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center gap-14 pr-14">
            {[
              'London', 'Birmingham', 'Coventry', 'Warwick', 'Leamington Spa', 'Canary Wharf',
              'Manchester', 'Solihull', 'Stratford-upon-Avon', 'Buyer-only representation', 'Search', 'Analysis',
              'Negotiation', 'Completion', 'Beyond the keys',
            ].map((word) => (
              <span class="flex items-center gap-14 font-display text-lg text-stone">
                {word}
                <span class="h-1 w-1 rounded-full bg-green-2/60" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Free price check: the lead-magnet marquee feature -->
  <section class="relative overflow-hidden bg-ink text-ivory">
    <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-[#e8a06b]">Free tool &middot; No account needed</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-[1.1] sm:text-4xl">
            Seen a home online? Know what to offer &mdash; before you call the agent.
          </h2>
          <p class="reveal reveal-d2 mt-5 max-w-2xl text-base leading-relaxed text-ivory/85">
            Type the postcode and asking price from any listing. We answer from recent sold prices near it:
            the opening offer to make, what to say when they counter, and the ceiling where you walk away.
          </p>
        </div>
        <div class="reveal reveal-d2 lg:col-span-4 lg:text-right">
          <a
            href="/price-check"
            class="inline-block bg-[#c2410c] px-8 py-4 text-base font-medium tracking-wide text-white transition-all duration-200 hover:bg-[#e0763a]"
          >
            Check a property now &rarr;
          </a>
          <p class="mt-3 text-xs text-ivory/60">Takes under a minute. The full playbook lands in your inbox.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Free deal check: the combined tool, price minus refurb, mirroring the bands above -->
  <section class="relative overflow-hidden border-t border-line-dark bg-ink text-ivory">
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-[#e8a06b]">Free tool &middot; No account needed</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-[1.1] sm:text-4xl">
            A home that needs work. Know what to offer, work and all.
          </h2>
          <p class="reveal reveal-d2 mt-5 max-w-2xl text-base leading-relaxed text-ivory/85">
            We value the home from recent sold prices, cost the work from our standing cost book, and take
            the work off the value to suggest an opening offer. No buffers, just the arithmetic, and the full
            breakdown in your inbox.
          </p>
        </div>
        <div class="reveal reveal-d2 lg:col-span-4 lg:text-right">
          <a
            href="/deal-check"
            class="inline-block bg-[#c2410c] px-8 py-4 text-base font-medium tracking-wide text-white transition-all duration-200 hover:bg-[#e0763a]"
          >
            Work out an offer &rarr;
          </a>
          <p class="mt-3 text-xs text-ivory/60">Takes under a minute. The full breakdown lands in your inbox.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Free refurb check: the second lead-magnet feature, mirroring the price check band -->
  <section class="relative overflow-hidden border-t border-line-dark bg-ink text-ivory">
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-[#e8a06b]">Free tool &middot; No account needed</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-[1.1] sm:text-4xl">
            Buying a project? Know what the work will cost before you offer.
          </h2>
          <p class="reveal reveal-d2 mt-5 max-w-2xl text-base leading-relaxed text-ivory/85">
            Tick what the property needs, from a new kitchen to a full rewire, add a postcode, and we cost it
            from our standing cost book. The headline range on screen, the full line by line breakdown in your inbox.
          </p>
        </div>
        <div class="reveal reveal-d2 lg:col-span-4 lg:text-right">
          <a
            href="/refurb-check"
            class="inline-block bg-[#c2410c] px-8 py-4 text-base font-medium tracking-wide text-white transition-all duration-200 hover:bg-[#e0763a]"
          >
            Cost a refurb now &rarr;
          </a>
          <p class="mt-3 text-xs text-ivory/60">Takes under a minute. The full breakdown lands in your inbox.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual audience entry paths -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">Two starting points</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      Where are you buying from?
    </h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <a href="/for-uk-nris" class="reveal-scale group relative flex min-h-[30rem] items-end overflow-hidden">
        <img
          src="/images/hero-street.webp"
          alt="Georgian terrace street in London at dusk, warm lights in the windows"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1400"
          height="939"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent transition-opacity duration-500 group-hover:opacity-95"></div>
        <div class="relative p-9 text-ivory lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">You live in the UK</p>
          <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
            Buying here, wanting the process handled properly
          </h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-ivory/80">
            First purchase or fifth, the process does not get friendlier: leasehold, gazumping, chains, surveys, and
            an agent who works for the seller. Many of our clients came to the UK before buying in it, NRIs among
            them, and we level the field for all of them.
          </p>
          <span class="link-line mt-7 inline-flex items-center gap-2 text-sm text-green-3">
            Start here
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
              >&rarr;</span
            >
          </span>
        </div>
      </a>
      <a href="/for-india-hnis" class="reveal-scale group relative flex min-h-[30rem] items-end overflow-hidden">
        <img
          src="/images/skyline.webp"
          alt="London skyline across the Thames at dusk"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1400"
          height="939"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent transition-opacity duration-500 group-hover:opacity-95"></div>
        <div class="relative p-9 text-ivory lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">You live abroad</p>
          <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
            Buying in the UK from thousands of miles away
          </h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-ivory/80">
            A child at university, a future move, or a sterling asset. Wherever home is right now, the question is
            trust: who views, who verifies, who negotiates, who holds the keys. That is precisely what we do.
          </p>
          <span class="link-line mt-7 inline-flex items-center gap-2 text-sm text-green-3">
            Start here
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
              >&rarr;</span
            >
          </span>
        </div>
      </a>
    </div>
    <a
      href="/services/managed-sale"
      class="reveal group mt-6 flex flex-wrap items-center justify-between gap-4 border border-line bg-ivory px-10 py-7 transition-all duration-300 hover:border-green-2/50"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-stone">
        <span class="font-display text-base font-medium text-ink">Selling a property?</span>
        &nbsp;We advise owners too: pricing research, agent selection and sale oversight, with your appointed agent
        doing the marketing.
      </p>
      <span class="inline-flex items-center gap-2 text-sm text-green-2">
        Sale advisory
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </span>
    </a>
  </section>

  <!-- Service pillars -->
  <section class="bg-ivory-2/50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">What we do</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-xl font-display text-3xl font-medium leading-tight sm:text-4xl">
            One relationship, the whole property lifecycle
          </h2>
        </div>
        <a href="/services" class="reveal reveal-d2 text-sm text-green-2 underline underline-offset-4">All services</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <ServiceCard
          href="/services/acquisition-search"
          number="01"
          title="Acquisition search and representation"
          body="A written brief, a full market search including off-market homes, institutional-grade analysis of every candidate, and negotiation by someone on your side of the table."
        />
        <ServiceCard
          href="/services/purchase-concierge"
          number="02"
          title="End to end purchase concierge"
          body="Solicitors chased, introductions made, paperwork signposted, utilities live on completion day. One accountable point of contact from offer to keys."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/management-oversight"
          number="03"
          title="Management oversight"
          body="After completion we appoint and supervise the letting agent, review every statement and inspect the property, so ownership from abroad feels like ownership from nearby."
          status="coming"
          delay="reveal-d2"
        />
        <ServiceCard
          href="/services/vacant-property-care"
          number="04"
          title="Vacant property care"
          body="Regular inspections with photo reports, key-holding, a vetted contractor network, and bills and mail handled while your property stands empty."
          status="coming"
        />
        <ServiceCard
          href="/services/managed-sale"
          number="05"
          title="Sale advisory and managed sale"
          body="Sellers get the same discipline: pricing research, exit strategy, estate agent selection and sale oversight. Your agent markets the property; Salet advises you."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/institutional"
          number="06"
          title="For institutions"
          body="Deal sourcing, screening and analysis for institutional clients, delivered privately under contract. A separate practice with the same standards."
          delay="reveal-d2"
        />
      </div>
    </div>
  </section>

  <!-- The whole market: traditional and modern -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">The whole market</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      Traditional or modern, the discipline is the same
    </h2>
    <p class="reveal reveal-d2 mt-5 max-w-2xl leading-relaxed text-stone">
      Georgian terraces, Canary Wharf glass, Manchester's new skyline. We judge property by evidence, not by era,
      and represent buyers across the whole of the UK market.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <figure class="reveal-scale group relative overflow-hidden">
        <img
          src="/images/cottage.webp"
          alt="English stone cottage with a lush green garden in summer sunshine"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Cottages and countryside</p>
          <p class="mt-1.5 font-display text-lg font-medium">Period charm, bought with a cool head</p>
        </figcaption>
      </figure>
      <figure class="reveal-scale group relative overflow-hidden md:translate-y-8">
        <img
          src="/images/canary-wharf.webp"
          alt="Canary Wharf glass towers at dusk"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Canary Wharf</p>
          <p class="mt-1.5 font-display text-lg font-medium">Towers, read building by building</p>
        </figcaption>
      </figure>
      <figure class="reveal-scale group relative overflow-hidden">
        <img
          src="/images/manchester.webp"
          alt="Central Manchester modern skyline at dusk"
          class="aspect-[3/4] w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]"
          loading="lazy"
          width="1200"
          height="1600"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        <figcaption class="absolute bottom-0 left-0 p-6 text-ivory">
          <p class="text-xs uppercase tracking-[0.24em] text-green-3">Central Manchester</p>
          <p class="mt-1.5 font-display text-lg font-medium">The new skyline, priced on evidence</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Buyer-only principle -->
  <section class="relative overflow-hidden bg-green text-ivory">
    <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-3">The principle</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-3xl font-medium leading-tight sm:text-5xl">
            One side of the table, <span class="grad-text">always yours.</span>
          </h2>
          <p class="reveal reveal-d2 mt-6 max-w-xl leading-relaxed text-ivory/80">
            In every purchase we act only for the buyer: no listings, no marketing mandates, no referral payments
            that would compromise the advice you receive. When owners engage us to sell, the roles stay just as
            clean: we advise you and oversee your appointed estate agent, who markets the property. Salet never acts
            for both sides of a transaction.
          </p>
          <div class="reveal reveal-d3 mt-8">
            <a href="/why-salet" class="link-line inline-flex items-center gap-2 text-sm text-green-3 hover:text-ivory">
              Why that matters &rarr;
            </a>
          </div>
        </div>
        <div class="reveal-scale lg:col-span-5">
          <div class="floaty relative overflow-hidden shadow-[0_40px_90px_-30px_rgba(0,0,0,0.6)]">
            <img
              src="/images/green-door.webp"
              alt="Deep green London townhouse door with brass hardware"
              class="h-full w-full object-cover"
              loading="lazy"
              width="1400"
              height="1045"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works, condensed -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">The journey</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      From first call to keys in hand
    </h2>
    <div class="mt-14 grid gap-10 md:grid-cols-4">
      {
        [
          ['Discovery', 'A 30 minute call. Your situation, your brief, and whether we are the right fit. Honest both ways.'],
          ['Search', 'We shortlist areas, search the whole market including off-market homes, and analyse every candidate before you see it.'],
          ['Negotiation', 'We attend viewings for you or with you, verify what agents claim, and negotiate as your sole representative.'],
          ['Completion and beyond', 'Solicitors chased, completion handled, keys held. Then oversight, care and eventually the sale, if you want us to stay.'],
        ].map(([title, body], i) => (
          <div class={`reveal ${['', 'reveal-d1', 'reveal-d2', 'reveal-d3'][i]}`}>
            <div class="flex items-center gap-4">
              <span class="font-display text-sm text-green-2">0{i + 1}</span>
              <div class="rule flex-1" />
            </div>
            <h3 class="mt-5 font-display text-xl font-medium">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone">{body}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12">
      <a href="/how-we-work" class="text-sm text-green-2 underline underline-offset-4">The full journey, step by step</a>
    </div>
  </section>

  <!-- Founder credibility -->
  <section class="bg-ivory-2/50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">Who you deal with</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-3xl font-medium leading-tight sm:text-4xl">
            Run by an operator, not a salesman
          </h2>
          <p class="reveal reveal-d2 mt-6 max-w-xl leading-relaxed text-stone">
            Salet is led by its founder, Saran Gandhi: a former Indian Army officer and nine years a senior leader at
            Amazon in Europe, responsible for operations serving over 100,000 frontline colleagues. He has lived the
            journey his clients are on, from India to the UK, and buys and analyses property with the same operational
            discipline he ran at scale.
          </p>
          <p class="reveal reveal-d2 mt-4 max-w-xl leading-relaxed text-stone">
            You deal with him directly. No handoffs, no junior staff, no call centre.
          </p>
          <div class="reveal reveal-d3 mt-8">
            <a href="/about" class="text-sm text-green-2 underline underline-offset-4">The full story</a>
          </div>
        </div>
        <div class="reveal reveal-d3 lg:col-span-5">
          <div class="grid gap-4">
            {
              [
                ['Indian Army', 'Commissioned officer. Standards, discipline, calm under pressure.'],
                ['Amazon EU, nine years', 'Senior operations leadership at continental scale.'],
                ['Founder, Salet', 'Independent, buyer-only, personally accountable.'],
              ].map(([title, body]) => (
                <div class="border border-line bg-ivory p-6">
                  <p class="font-display text-lg font-medium">{title}</p>
                  <p class="mt-2 text-sm leading-relaxed text-stone">{body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial slot + insights teaser -->
