---
import Base from '../layouts/Base.astro';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialSlot from '../components/TestimonialSlot.astro';
---
<Base
  title="Salet | The buyer-only UK property concierge"
  description="Buyer-only representation and end to end property concierge for UK home buyers and overseas buyers, with particular fluency for clients buying from India. Salet acts only for you."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-ivory">
    <svg
      class="pointer-events-none absolute -right-32 bottom-0 h-[120%] w-auto opacity-[0.07]"
      viewBox="0 0 500 700"
      fill="none"
      aria-hidden="true"
    >
      <path d="M80 700V260C80 150 165 65 275 65s195 85 195 195v440" stroke="#faf8f2" stroke-width="1.5" />
      <path d="M150 700V290c0-70 55-125 125-125s125 55 125 125v410" stroke="#faf8f2" stroke-width="1" />
      <path d="M215 700V320c0-33 27-60 60-60s60 27 60 60v380" stroke="#faf8f2" stroke-width="0.75" />
      <line x1="0" y1="700" x2="500" y2="700" stroke="#faf8f2" />
    </svg>
    <div class="relative mx-auto max-w-6xl px-6 pb-28 pt-44 lg:px-8 lg:pb-36 lg:pt-56">
      <p class="reveal text-xs uppercase tracking-[0.28em] text-green-3">Property concierge, United Kingdom</p>
      <h1
        class="reveal reveal-d1 mt-6 max-w-4xl font-display text-4xl font-medium leading-[1.06] sm:text-6xl lg:text-7xl"
      >
        Buy UK property with someone who acts only for you.
      </h1>
      <p class="reveal reveal-d2 mt-8 max-w-2xl text-lg leading-relaxed text-mist">
        Salet is a buyer-only property concierge. We search, analyse, negotiate and manage the entire purchase, then
        look after what you own. We work for buyers everywhere, from Coventry to Canary Wharf to clients calling from
        Mumbai and Delhi. The seller has an agent. Now you do too.
      </p>
      <div class="reveal reveal-d3 mt-11 flex flex-wrap items-center gap-6">
        <a
          href="/contact"
          class="group inline-flex items-center gap-4 border border-green-3/50 bg-green-2/20 px-8 py-5 text-base tracking-wide transition-all duration-300 hover:border-green-3 hover:bg-green-2"
        >
          Book a discovery call
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
            >&rarr;</span
          >
        </a>
        <a href="/how-we-work" class="text-sm tracking-wide text-mist underline underline-offset-4 hover:text-ivory">
          See how we work
        </a>
      </div>
    </div>
  </section>

  <!-- Dual audience entry paths -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">Two starting points</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      Where are you buying from?
    </h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <a
        href="/for-uk-nris"
        class="reveal group relative overflow-hidden border border-line bg-ivory-2/60 p-10 transition-all duration-300 hover:border-green-2/50 hover:shadow-[0_18px_50px_-20px_rgba(27,26,23,0.18)] lg:p-12"
      >
        <p class="text-xs uppercase tracking-[0.24em] text-green-2">You live in the UK</p>
        <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
          Buying here, wanting the process handled properly
        </h3>
        <p class="mt-5 max-w-md leading-relaxed text-stone">
          First purchase or fifth, the process does not get friendlier: leasehold, gazumping, chains, surveys, and an
          agent who works for the seller. Many of our clients came to the UK before buying in it, NRIs among them,
          and we level the field for all of them.
        </p>
        <span class="mt-8 inline-flex items-center gap-2 text-sm text-green-2">
          Start here
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"
            >&rarr;</span
          >
        </span>
      </a>
      <a
        href="/for-india-hnis"
        class="reveal reveal-d1 group relative overflow-hidden border border-line bg-ivory-2/60 p-10 transition-all duration-300 hover:border-green-2/50 hover:shadow-[0_18px_50px_-20px_rgba(27,26,23,0.18)] lg:p-12"
      >
        <p class="text-xs uppercase tracking-[0.24em] text-green-2">You live abroad</p>
        <h3 class="mt-4 font-display text-2xl font-medium leading-snug sm:text-3xl">
          Buying in the UK from thousands of miles away
        </h3>
        <p class="mt-5 max-w-md leading-relaxed text-stone">
          A child at university, a future move, or a sterling asset. From Mumbai or Dubai or anywhere else, the
          question is trust: who views, who verifies, who negotiates, who holds the keys. That is precisely what we
          do.
        </p>
        <span class="mt-8 inline-flex items-center gap-2 text-sm text-green-2">
          Start here
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"
            >&rarr;</span
          >
        </span>
      </a>
    </div>
    <a
      href="/services/managed-sale"
      class="reveal group mt-6 flex flex-wrap items-center justify-between gap-4 border border-line bg-ivory px-10 py-7 transition-all duration-300 hover:border-green-2/50"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-stone">
        <span class="font-display text-base font-medium text-ink">Selling a property?</span>
        &nbsp;We advise owners too: pricing research, agent selection and sale oversight, with your appointed agent
        doing the marketing.
      </p>
      <span class="inline-flex items-center gap-2 text-sm text-green-2">
        Sale advisory
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </span>
    </a>
  </section>

  <!-- Service pillars -->
  <section class="bg-ivory-2/50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">What we do</p>
          <h2 class="reveal reveal-d1 mt-4 max-w-xl font-display text-3xl font-medium leading-tight sm:text-4xl">
            One relationship, the whole property lifecycle
          </h2>
        </div>
        <a href="/services" class="reveal reveal-d2 text-sm text-green-2 underline underline-offset-4">All services</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <ServiceCard
          href="/services/acquisition-search"
          number="01"
          title="Acquisition search and representation"
          body="A written brief, a full market search including off-market homes, institutional-grade analysis of every candidate, and negotiation by someone on your side of the table."
        />
        <ServiceCard
          href="/services/purchase-concierge"
          number="02"
          title="End to end purchase concierge"
          body="Solicitors chased, introductions made, paperwork signposted, utilities live on completion day. One accountable point of contact from offer to keys."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/management-oversight"
          number="03"
          title="Management oversight"
          body="After completion we appoint and supervise the letting agent, review every statement and inspect the property, so ownership from abroad feels like ownership from nearby."
          status="coming"
          delay="reveal-d2"
        />
        <ServiceCard
          href="/services/vacant-property-care"
          number="04"
          title="Vacant property care"
          body="Regular inspections with photo reports, key-holding, a vetted contractor network, and bills and mail handled while your property stands empty."
          status="coming"
        />
        <ServiceCard
          href="/services/managed-sale"
          number="05"
          title="Sale advisory and managed sale"
          body="Sellers get the same discipline: pricing research, exit strategy, estate agent selection and sale oversight. Your agent markets the property; Salet advises you."
          delay="reveal-d1"
        />
        <ServiceCard
          href="/services/institutional"
          number="06"
          title="For institutions"
          body="Deal sourcing, screening and analysis for institutional clients, delivered privately under contract. A separate practice with the same standards."
          delay="reveal-d2"
        />
      </div>
    </div>
  </section>

  <!-- Buyer-only principle -->
  <section class="bg-green text-ivory">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-3">The principle</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-3xl font-medium leading-tight sm:text-4xl">
            One side of the table, always yours.
          </h2>
          <p class="reveal reveal-d2 mt-6 max-w-xl leading-relaxed text-ivory/80">
            In every purchase we act only for the buyer: no listings, no marketing mandates, no referral payments
            that would compromise the advice you receive. When owners engage us to sell, the roles stay just as
            clean: we advise you and oversee your appointed estate agent, who markets the property. Salet never acts
            for both sides of a transaction.
          </p>
        </div>
        <div class="reveal reveal-d3 self-end lg:col-span-5 lg:justify-self-end">
          <a href="/why-salet" class="inline-flex items-center gap-2 text-sm text-green-3 underline underline-offset-4 hover:text-ivory">
            Why that matters &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works, condensed -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">The journey</p>
    <h2 class="reveal reveal-d1 mt-4 max-w-2xl font-display text-3xl font-medium leading-tight sm:text-4xl">
      From first call to keys in hand
    </h2>
    <div class="mt-14 grid gap-10 md:grid-cols-4">
      {
        [
          ['Discovery', 'A 30 minute call. Your situation, your brief, and whether we are the right fit. Honest both ways.'],
          ['Search', 'We shortlist areas, search the whole market including off-market homes, and analyse every candidate before you see it.'],
          ['Negotiation', 'We attend viewings for you or with you, verify what agents claim, and negotiate as your sole representative.'],
          ['Completion and beyond', 'Solicitors chased, completion handled, keys held. Then oversight, care and eventually the sale, if you want us to stay.'],
        ].map(([title, body], i) => (
          <div class={`reveal ${['', 'reveal-d1', 'reveal-d2', 'reveal-d3'][i]}`}>
            <div class="flex items-center gap-4">
              <span class="font-display text-sm text-green-2">0{i + 1}</span>
              <div class="rule flex-1" />
            </div>
            <h3 class="mt-5 font-display text-xl font-medium">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone">{body}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal mt-12">
      <a href="/how-we-work" class="text-sm text-green-2 underline underline-offset-4">The full journey, step by step</a>
    </div>
  </section>

  <!-- Founder credibility -->
  <section class="bg-ivory-2/50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">Who you deal with</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-3xl font-medium leading-tight sm:text-4xl">
            Run by an operator, not a salesman
          </h2>
          <p class="reveal reveal-d2 mt-6 max-w-xl leading-relaxed text-stone">
            Salet is led by its founder, Saran Gandhi: a former Indian Army officer and nine years a senior leader at
            Amazon in Europe, responsible for operations serving over 100,000 frontline colleagues. He has lived the
            journey his clients are on, from India to the UK, and buys and analyses property with the same operational
            discipline he ran at scale.
          </p>
          <p class="reveal reveal-d2 mt-4 max-w-xl leading-relaxed text-stone">
            You deal with him directly. No handoffs, no junior staff, no call centre.
          </p>
          <div class="reveal reveal-d3 mt-8">
            <a href="/about" class="text-sm text-green-2 underline underline-offset-4">The full story</a>
          </div>
        </div>
        <div class="reveal reveal-d3 lg:col-span-5">
          <div class="grid gap-4">
            {
              [
                ['Indian Army', 'Commissioned officer. Standards, discipline, calm under pressure.'],
                ['Amazon EU, nine years', 'Senior operations leadership at continental scale.'],
                ['Founder, Salet', 'Independent, buyer-only, personally accountable.'],
              ].map(([title, body]) => (
                <div class="border border-line bg-ivory p-6">
                  <p class="font-display text-lg font-medium">{title}</p>
                  <p class="mt-2 text-sm leading-relaxed text-stone">{body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial slot + insights teaser -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-2">
      <div class="reveal">
        <TestimonialSlot />
      </div>
      <div class="reveal reveal-d1">
        <p class="text-xs uppercase tracking-[0.28em] text-green-2">From the insights desk</p>
        <ul class="mt-6 space-y-5">
          <li>
            <a href="/insights/what-uk-nris-get-wrong" class="group block">
              <p class="font-display text-lg font-medium leading-snug transition-colors group-hover:text-green-2">
                What UK-based NRIs get wrong about buying property here versus back home
              </p>
            </a>
          </li>
          <li>
            <a href="/insights/how-a-buying-concierge-earns-its-fee" class="group block">
              <p class="font-display text-lg font-medium leading-snug transition-colors group-hover:text-green-2">
                How a buying concierge actually earns its fee
              </p>
            </a>
          </li>
          <li>
            <a href="/insights/west-midlands-area-guide" class="group block">
              <p class="font-display text-lg font-medium leading-snug transition-colors group-hover:text-green-2">
                The West Midlands: an overseas buyer's guide to Birmingham, Coventry and Warwick
              </p>
            </a>
          </li>
        </ul>
        <div class="mt-8">
          <a href="/insights" class="text-sm text-green-2 underline underline-offset-4">All insights</a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
