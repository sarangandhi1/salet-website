---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

const reasons = [
  {
    title: 'One side of the table, always',
    body: 'We act only for the buyer. No listings, no referral payments, never both sides of a sale.',
  },
  {
    title: 'Cross-border fluency',
    body: 'The UK process and the India context, held in one head.',
  },
  {
    title: 'Discretion as a default',
    body: 'No client names, purchase details or photographs published. Ever.',
  },
  {
    title: 'An operating record, not a sales record',
    body: 'Nine years running operations at Amazon in Europe, and an Indian Army officer before that.',
  },
];
---
<Base
  title="Why Use a Buyer-Only Buying Agent in the UK | Salet"
  description="Why clients choose Salet: buyer-only representation without exception, cross-border fluency between the UK process and the India context, discretion as a default, and a founder with an operating record."
>
  <PageHero
    eyebrow="Why Salet"
    title="Four reasons clients choose us, stated plainly"
    lede="Who we work for, what we know, how we behave and who is accountable."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        reasons.map((r, i) => (
          <div class={`reveal ${i % 2 === 1 ? 'reveal-d1' : ''} border border-line bg-ivory p-9 lg:p-12`}>
            <span class="font-display text-sm text-green-2">0{i + 1}</span>
            <h2 class="mt-4 font-display text-2xl font-medium leading-snug">{r.title}</h2>
            <p class="mt-4 leading-relaxed text-stone">{r.body}</p>
          </div>
        ))
      }
    </div>

  </section>

  <CTABand />
</Base>
