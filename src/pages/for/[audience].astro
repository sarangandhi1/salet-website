---
import ReportsShell from '../../components/ReportsShell.astro';
import ProductTile from '../../components/ProductTile.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import { AUDIENCES, SAMPLE_INTEL } from '../../data/reports';

// One hub per kind of buyer: home buyers and investors. Tools for sourcers
// and estate agents live on Salet Pro, not here. Same tiles as /reports,
// filtered to what that audience buys.
export function getStaticPaths() {
  return AUDIENCES.map((a) => ({ params: { audience: a.slug } }));
}

const { audience } = Astro.params as { audience: string };
const a = AUDIENCES.find((x) => x.slug === audience)!;
const back = `/for/${a.slug}`;
const others = AUDIENCES.filter((x) => x.slug !== a.slug);

---
<ReportsShell title={a.title} description={a.lede}>
  <header class="rp-hero">
    <div class="rp-wrap">
      <p class="rp-eyebrow">For {a.label.toLowerCase()}</p>
      <h1 class="rp-h1">{a.h1}</h1>
      <p class="rp-lede">{a.lede}</p>
      <p class="rp-lede" style="font-size:0.95rem;margin:0">
        Read one first: <a class="rp-link" href={SAMPLE_INTEL}>sample property report</a>.
      </p>
    </div>
  </header>

  <TrustStrip />

  <section class="rp-section">
    <div class="rp-wrap">
      <p id="notified" class="rp-thanks" hidden>Thank you. We will email you the day it goes live, and only then.</p>
      <h2 class="rp-h2">What we have for {a.label.toLowerCase()}</h2>
      <p class="rp-sub">One payment by card. No subscription. Products marked coming soon take your email and tell you the day they go live.</p>
      <div class="rp-tiles">
        {a.products.map((p) => <ProductTile p={p} back={back} />)}
      </div>
    </div>
  </section>

  {
    a.free && (
      <section class="rp-section" style="padding-top:0" id="free">
        <div class="rp-wrap">
          <h2 class="rp-h2" style="font-size:1.5rem">Free checks, no account needed</h2>
          <div class="rp-chips" style="margin-top:1rem">
            {a.free.map((t) => <a href={t.href}>{t.label}</a>)}
          </div>
        </div>
      </section>
    )
  }

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap" style="max-width:48rem">
      <h2 class="rp-h2">Questions</h2>
      <div class="rp-faq">
        {a.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap">
      <h2 class="rp-h2" style="font-size:1.4rem">Not you?</h2>
      <div class="rp-chips" style="margin-top:1rem">
        {others.map((o) => <a href={`/for/${o.slug}`}>For {o.label.toLowerCase()}</a>)}
        <a href="/reports">All reports and prices</a>
      </div>
    </div>
  </section>

  {
    a.service && (
      <p class="rp-agent">
        {a.service} <a href="/services">buying agent</a>.
      </p>
    )
  }
</ReportsShell>

<script>
  if (new URLSearchParams(location.search).has('notified')) {
    document.getElementById('notified')?.removeAttribute('hidden');
  }
</script>
