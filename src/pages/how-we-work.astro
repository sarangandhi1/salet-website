---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

const phases = [
  {
    phase: 'Before anything',
    steps: [
      ['The discovery call', 'Thirty minutes, no obligation. We tell you honestly whether Salet is the right fit.'],
      ['The proposal and engagement', 'Scope, fee and timeline in writing. The retainer is deducted from a success fee due only at exchange.'],
    ],
  },
  {
    phase: 'The search',
    steps: [
      ['The written brief', 'Purpose, areas, budget and deal-breakers, signed off. Every home is judged against it.'],
      ['Area strategy and search', 'Portals, agents, pre-market and off-market. You see contenders, not noise.'],
      ['Analysis before enthusiasm', 'Comparable sales, fair value and the flags, before any viewing.'],
      ['Viewings that tell the truth', 'In person, with you or for you. Video for remote clients, faults included.'],
    ],
  },
  {
    phase: 'The purchase',
    steps: [
      ['Negotiation', 'Evidence-led, and kept up through the survey and legal findings.'],
      ['Progression', 'Solicitors, surveyors and brokers chased weekly. One progress note.'],
      ['Exchange and completion', 'Funds confirmed, keys collected, utilities live, documents in one pack.'],
    ],
  },
  {
    phase: 'Beyond the keys',
    steps: [
      ['The relationship continues', 'Management oversight, vacant property care and a managed sale, each optional.'],
    ],
  },
];
---
<Base
  title="How a UK Buying Agent Works, Step by Step | Salet"
  description="The Salet client journey step by step: discovery call, written brief, whole-of-market search, analysis, viewings, negotiation, exchange, completion and the relationship beyond the keys."
>
  <PageHero
    eyebrow="How we work"
    title="A process you can hold us to"
    lede="Salet acts only for you. Here is the buying journey, end to end."
    compact
  />

  <section class="mx-auto max-w-4xl px-6 py-16 lg:px-8 lg:py-24">
    {
      phases.map((group) => (
        <div class="mb-16 last:mb-0">
          <p class="reveal text-xs uppercase tracking-[0.28em] text-green-2">{group.phase}</p>
          <div class="mt-8 space-y-12">
            {group.steps.map(([title, body]) => (
              <div class="reveal border-l border-line pl-8">
                <h2 class="font-display text-2xl font-medium leading-snug">{title}</h2>
                <p class="mt-3.5 leading-relaxed text-stone">{body}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <div class="reveal mt-4 border border-green-2/30 bg-green/5 p-8 lg:p-10">
      <p class="text-xs uppercase tracking-[0.24em] text-green-2">The self-funding point</p>
      <p class="mt-4 leading-relaxed text-stone">
        In many purchases the negotiated saving is larger than the fee. No promises, but we will walk you through
        the numbers on the call.
      </p>
    </div>
  </section>

  <CTABand />
</Base>
