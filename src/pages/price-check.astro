---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

// The widget is served by Salet's price-check service (same engine that runs
// our internal underwriting) and wears the site palette via query params.
const WIDGET_URL =
  'https://dealforge-2fkp.onrender.com/widget?primary=2e5a40&accent=2e5a40&bg=f2eee4&btn=C2410C';
---
<Base
  title="Free property price check | What should you offer? | Salet"
  description="Type the postcode and asking price from any UK listing and get a data-driven answer from recent sold prices: the opening offer to make, how to handle the counter, and the ceiling where you walk away."
>
  <PageHero
    eyebrow="Free price check"
    title="What should you offer?"
    lede="Seen a home you like on Rightmove or Zoopla? Type the facts from the ad. We answer from recent sold prices near it — not opinion, not the asking price."
    compact
  />

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="reveal border border-line bg-ivory p-2">
          <iframe
            src={WIDGET_URL}
            title="Salet price check"
            style="width:100%;height:820px;border:0;display:block;background:#ffffff;"
            loading="lazy"
          ></iframe>
        </div>
        <p class="reveal mt-4 text-xs leading-relaxed text-mist">
          A data-driven estimate from recent sold prices — not a valuation. A survey and your
          own viewing complete the picture. Three free checks per day.
        </p>
        <p class="reveal mt-6 border-l-2 border-green-2 pl-4 text-sm leading-relaxed text-slate">
          Buying at auction? We also read the legal pack and report what it says, with the page
          behind every finding. <a href="/reports/legal-pack" class="text-green-2 underline">Paperwork review</a>,
          free preview.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="reveal border border-line bg-ivory p-9 lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">How it works</p>
          <ul class="mt-6 space-y-4 text-sm leading-relaxed text-stone">
            <li>
              <strong class="text-ink">1. Type what the ad shows.</strong> Postcode, asking price,
              bedrooms — floor area and price cuts sharpen the answer.
            </li>
            <li>
              <strong class="text-ink">2. We read the sold evidence.</strong> Recent sale prices
              per square metre around that exact postcode — the same data we use when we
              represent buyers professionally.
            </li>
            <li>
              <strong class="text-ink">3. You get the negotiation playbook.</strong> The precise
              opening offer with reasons to say out loud, the counter move, and the walk-away
              ceiling — on screen and in your inbox.
            </li>
          </ul>
        </div>

        <div class="reveal reveal-d1 mt-8 border border-line bg-ivory-2/60 p-9 lg:p-12">
          <p class="text-xs uppercase tracking-[0.24em] text-green-2">Why we give this away</p>
          <p class="mt-5 text-sm leading-relaxed text-stone">
            Because it shows how we work: evidence first, always on the buyer's side. If the
            numbers make you want a professional in your corner — for the search, the viewings
            and the negotiation itself — that is exactly what Salet does.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-block border border-green-2 px-6 py-3 text-sm tracking-wide text-green-2 transition-all duration-200 hover:bg-green-2 hover:text-ivory"
          >
            Book a free discovery call
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
