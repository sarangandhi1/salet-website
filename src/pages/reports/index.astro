---
import ReportsShell from '../../components/ReportsShell.astro';
import PricingBoard from '../../components/PricingBoard.astro';
import AudienceBar from '../../components/AudienceBar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SALET_AUDIENCE_LINKS } from '../../lib/sites';
import { AUDIENCES, SAMPLE_INTEL } from '../../data/reports';
import { SALET_TABS, SALET_COMPARE, SALET_FAQS, SALET_PROOF, SALET_BANNER } from '../../data/pricing';
import { PRODUCTS } from '../../data/reports';
import { faqSchema, productSchema } from '../../lib/schema';

const schema = [
  ...PRODUCTS.map((p) => productSchema(p, p.slug ? `https://salet.uk/reports/${p.slug}/` : 'https://salet.uk/reports/')),
  faqSchema(SALET_FAQS),
];

// The pricing page. The visitor picks the job first ("Checking one home",
// "Comparing a few", "Buying with help") and sees three cards for it.
// Everything else is one tap away in "Compare everything".
---
<ReportsShell
  title="Property report prices from £9 | Salet"
  description="Check one home from £9, see the full cost of buying it, or compare a shortlist. One payment, no subscription, full refund within 30 days if not useful."
  schema={schema}
>
  <header class="rp-hero" style="padding-bottom:3rem">
    <div class="rp-wrap" style="text-align:center">
      <div style="display:flex;justify-content:center"><Breadcrumb trail={[{ label: 'Salet', href: '/' }, { label: 'Reports and prices' }]} /></div>
      <p class="rp-eyebrow">Pricing</p>
      <h1 class="rp-h1" style="margin-left:auto;margin-right:auto">Simple prices. From £9.</h1>
      <p class="rp-lede" style="margin:0 auto">
        Pick what you are doing. Every report shows you real data on your address before you pay, and you pay once.
        <a class="rp-link" href={SAMPLE_INTEL}>See a sample report</a>
      </p>
    </div>
  </header>

  <AudienceBar items={SALET_AUDIENCE_LINKS} top={88} />

  <section class="rp-section">
    <div class="rp-wrap">
      <PricingBoard
        tabs={SALET_TABS}
        compare={SALET_COMPARE}
        faqs={SALET_FAQS}
        proof={SALET_PROOF}
        banner={SALET_BANNER}
        back="https://salet.uk/reports"
        sticky={{ label: 'Check a property from £9', href: 'https://reports.salet.uk/intelligence' }}
      />
    </div>
  </section>

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap" style="text-align:center">
      <div class="rp-chips" style="justify-content:center">
        {AUDIENCES.map((a) => <a href={`/for/${a.slug}`}>For {a.label.toLowerCase()}</a>)}
      </div>
    </div>
  </section>
</ReportsShell>
