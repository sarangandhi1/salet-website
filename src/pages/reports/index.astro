---
import ReportsShell from '../../components/ReportsShell.astro';
import PricingBoard from '../../components/PricingBoard.astro';
import { AUDIENCES, SAMPLE_INTEL } from '../../data/reports';
import { SALET_TABS, SALET_COMPARE, SALET_FAQS, SALET_PROOF, SALET_BANNER } from '../../data/pricing';

// The pricing page. The visitor picks the job first ("Checking one home",
// "Comparing a few", "Buying with help") and sees three cards for it.
// Everything else is one tap away in "Compare everything".
---
<ReportsShell
  title="Pricing | Property reports from £19, free preview first | Salet"
  description="Check one home for £19, see the full cost of buying it, or compare a shortlist. Every report starts with a free preview. One payment, no subscription."
>
  <header class="rp-hero" style="padding-bottom:3rem">
    <div class="rp-wrap" style="text-align:center">
      <p class="rp-eyebrow">Pricing</p>
      <h1 class="rp-h1" style="margin-left:auto;margin-right:auto">Simple prices. Free preview first.</h1>
      <p class="rp-lede" style="margin:0 auto">
        Pick what you are doing. Every report shows you real data on your address before you pay, and you pay once.
        <a class="rp-link" href={SAMPLE_INTEL}>See a sample report</a>
      </p>
    </div>
  </header>

  <section class="rp-section">
    <div class="rp-wrap">
      <PricingBoard
        tabs={SALET_TABS}
        compare={SALET_COMPARE}
        faqs={SALET_FAQS}
        proof={SALET_PROOF}
        banner={SALET_BANNER}
        back="https://salet.uk/reports"
        sticky={{ label: 'Check a property: free preview', href: 'https://reports.salet.uk/intelligence' }}
      />
    </div>
  </section>

  <section class="rp-section" style="padding-top:0">
    <div class="rp-wrap" style="text-align:center">
      <div class="rp-chips" style="justify-content:center">
        {AUDIENCES.map((a) => <a href={`/for/${a.slug}`}>For {a.label.toLowerCase()}</a>)}
      </div>
    </div>
  </section>
</ReportsShell>
