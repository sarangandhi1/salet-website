---
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink text-ivory">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green-3/40 to-transparent" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="font-display text-2xl font-medium tracking-tight">Salet<span class="text-dot">.</span></p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-mist">
          The property concierge for UK and overseas buyers. Buyer-only representation across the United Kingdom.
        </p>
        <div class="mt-6 space-y-1.5 text-sm">
          <a href="mailto:saran@salet.uk" class="block text-green-3 hover:text-ivory">saran@salet.uk</a>
          <a href="tel:+447878781100" class="block text-green-3 hover:text-ivory">+44 7878 781100</a>
          <a href="https://wa.me/447878781100" rel="noopener" target="_blank" class="block text-green-3 hover:text-ivory">WhatsApp us</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-[0.2em] text-mist">Services</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/acquisition-search">Acquisition search</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/purchase-concierge">Purchase concierge</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/management-oversight">Management oversight</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/vacant-property-care">Vacant property care</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/managed-sale">Sale advisory</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/services/institutional">For institutions</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="text-xs uppercase tracking-[0.2em] text-mist">Company</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-ivory/80 hover:text-ivory" href="/how-we-work">How we work</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/why-salet">Why Salet</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/about">About</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/insights">Insights</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/guide">Buying guide</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-[0.2em] text-mist">Begin</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a class="text-ivory/80 hover:text-ivory" href="/for-uk-nris">For UK-based NRIs</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/for-india-hnis">For India-based buyers</a></li>
          <li><a class="text-ivory/80 hover:text-ivory" href="/contact">Book a discovery call</a></li>
        </ul>
        <div class="mt-6 border border-line-dark px-4 py-3 text-xs leading-relaxed text-mist">
          Professional indemnity insurance held.<br />
          Registered in England and Wales.
          <!-- TODO: add The Property Ombudsman and PropertyMark badges here once membership is actually held. Display nothing until then. -->
        </div>
      </div>
    </div>

    <div class="rule-dark mt-14"></div>

    <div class="mt-8 space-y-3 text-xs leading-relaxed text-mist">
      <p>
        Salet Ltd, company no. 16662600. Registered office: 71-75 Shelton Street, Covent Garden, London WC2H 9JQ.
      </p>
      <p>
        Salet provides property consulting and buyer representation. Salet does not provide financial, tax or
        investment advice. Nothing on this site is an offer or promotion of any property or investment.
      </p>
      <p>&copy; {year} Salet Ltd. All rights reserved.</p>
    </div>
  </div>
  <div class="pointer-events-none relative -mb-8 flex justify-center overflow-hidden" aria-hidden="true">
    <span class="watermark">Salet.</span>
  </div>
</footer>
