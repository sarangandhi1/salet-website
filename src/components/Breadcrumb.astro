---
// "Salet › For home buyers › Buyer Intelligence Report", plus an optional
// "← All reports" link, at the top of a page hero (light text on navy).
interface Props {
  trail: { label: string; href?: string }[];
  back?: { label: string; href: string };
}
const { trail, back } = Astro.props;
---
<div class="bc">
  {back && <a class="bc-back" href={back.href}>&larr; {back.label}</a>}
  <nav aria-label="Breadcrumb">
    <ol>
      {
        trail.map((t, i) => (
          <li>
            {t.href && i < trail.length - 1 ? <a href={t.href}>{t.label}</a> : <span aria-current="page">{t.label}</span>}
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<style>
  .bc { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.25rem; margin: 0 0 1.4rem; font-size: 0.88rem; }
  .bc-back {
    display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; color: #fff; text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.55); border-radius: 999px; padding: 0.35rem 0.85rem;
  }
  .bc-back:hover { background: rgba(255, 255, 255, 0.12); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; color: rgba(255, 255, 255, 0.7); }
  li:not(:last-child)::after { content: "\203A"; margin-left: 0.3rem; color: rgba(255, 255, 255, 0.45); }
  a { color: rgba(255, 255, 255, 0.85); text-decoration: underline; text-underline-offset: 3px; }
  a:hover { color: #fff; }
  span[aria-current] { color: #fff; font-weight: 600; }
</style>
