---
// TODO: replace with a real client testimonial (verbatim, with permission) after the first engagements complete.
// Never invent a quote, a name or an outcome.
interface Props {
  context?: string;
}
const { context = 'Client words will appear here as engagements complete.' } = Astro.props;
---
