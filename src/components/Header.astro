---
import { AUDIENCES, SAMPLE_INTEL, pick } from '../data/reports';
import { PRO_URL, PAY_INVOICE_URL } from '../lib/sites';

const nav = [
  { href: '/services', label: 'Services' },
  { href: '/how-we-work', label: 'How we work' },
  { href: '/why-salet', label: 'Why Salet' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
];
// Everything Salet sells sits in one highlighted "Products" menu, grouped by
// who buys it: home buyers and investors here, sourcers and estate agents on
// Salet Pro. Each group heading opens that audience's page. Names and prices
// come from the catalogue.
const groups = AUDIENCES.map((a) => ({
  href: `/for/${a.slug}`,
  label: `For ${a.label.toLowerCase()}`,
  items: [
    ...a.products.map((p) => ({
      href: p.slug ? `/reports/${p.slug}` : `/for/${a.slug}#${p.key}`,
      label: p.name,
      price: p.notify ? 'Soon' : p.price,
    })),
    ...(a.area ? [{ href: '/area', label: 'Is my area getting busier?', price: 'Area data' }] : []),
  ],
})).concat(
  [
    { slug: 'sourcers', label: 'For sourcers', keys: ['offmarket', 'pack-builder', 'sourcer-pass', 'demand-board', 'letter-kit', 'photo-refurb'] },
    { slug: 'agents', label: 'For estate agents', keys: ['seller-leads', 'valuation-evidence', 'market-brief', 'data-licence', 'bespoke'] },
  ].map((g) => ({
    href: `${PRO_URL}/${g.slug}`,
    label: `${g.label} (Salet Pro)`,
    items: pick(...g.keys).map((p) => ({
      href: p.key === 'bespoke' ? p.href : `${PRO_URL}/${g.slug}#${p.key}`,
      label: p.name,
      price: p.notify ? 'Soon' : p.price,
    })),
  })),
);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 lg:px-8">
    <a href="/" class="font-display text-2xl font-medium tracking-tight text-ivory" aria-label="Salet home">
      Salet<span class="text-dot">.</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-glow text-sm tracking-wide transition-colors duration-200',
              path.startsWith(item.href) ? 'text-white' : 'text-ivory/85 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1.5 border border-[#e0763a]/60 bg-[#c2410c]/20 px-5 py-2.5 text-sm font-medium tracking-wide text-ivory transition-all duration-200 hover:border-[#e0763a] hover:bg-[#c2410c] group-focus-within:border-[#e0763a] group-focus-within:bg-[#c2410c]"
          aria-haspopup="true"
        >
          Products
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="invisible absolute right-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="max-h-[calc(100vh-6rem)] w-[46rem] overflow-y-auto border border-line-dark bg-ink shadow-xl">
            <div class="grid grid-cols-2 gap-x-2 px-3 pt-3">
              {groups.map((g) => (
                <div class="pb-3">
                  <a href={g.href} class="block px-3 pb-1.5 pt-2 text-[0.7rem] uppercase tracking-[0.2em] text-[#e0763a] hover:text-white">{g.label} &rarr;</a>
                  {g.items.map((i) => (
                    <a href={i.href} class="flex items-center justify-between gap-3 px-3 py-1.5 text-sm text-ivory/90 transition-colors hover:bg-white/5 hover:text-white">
                      <span>{i.label}</span>
                      <span class="text-xs text-ivory/55">{i.price}</span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
            <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line-dark/60 px-6 py-3.5 text-sm">
              <a href="/reports" class="text-ivory/90 hover:text-white">Pricing</a>
              <a href={SAMPLE_INTEL} class="text-ivory/90 hover:text-white">Sample report</a>
              <a href="/area" class="text-ivory/90 hover:text-white">Is my area getting busier?</a>
              <a href={PRO_URL} class="text-ivory/90 hover:text-white">Salet Pro</a>
              <a href={PAY_INVOICE_URL} class="text-ivory/90 hover:text-white">Pay an invoice</a>
            </div>
          </div>
        </div>
      </div>
      <a href="/brief" class="bg-[#c2410c] px-5 py-2.5 text-sm font-semibold tracking-wide text-white transition-colors hover:bg-[#a6370a]">Find my home</a>
      <a
        href="/contact"
        class="border border-green-3/40 bg-green-2/20 px-5 py-2.5 text-sm tracking-wide text-ivory transition-all duration-200 hover:border-green-3 hover:bg-green-2"
      >
        Book a discovery call
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block h-px w-6 bg-ivory transition-transform duration-300"></span>
      <span class="block h-px w-6 bg-ivory transition-opacity duration-300"></span>
      <span class="block h-px w-6 bg-ivory transition-transform duration-300"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line-dark bg-ink px-6 pb-8 pt-4 lg:hidden">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        nav.map((item) => (
          <a href={item.href} class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">
            {item.label}
          </a>
        ))
      }
      <p class="mt-5 text-[0.68rem] uppercase tracking-[0.2em] text-mist">Products</p>
      <div class="mt-2 grid grid-cols-2 gap-2">
        {groups.map((g) => (
          <a href={g.href} class="bg-[#c2410c] px-3 py-3 text-center text-sm font-medium text-ivory">{g.label}</a>
        ))}
      </div>
      <a href="/reports" class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">Pricing</a>
      <a href={SAMPLE_INTEL} class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">Sample report</a>
      <a href="/area" class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">Is my area getting busier?</a>
      <a href={PRO_URL} class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">Salet Pro, for professionals</a>
      <a href={PAY_INVOICE_URL} class="border-b border-line-dark/60 py-3.5 text-base text-ivory/90">Pay an invoice</a>
      <a href="/brief" class="mt-3 bg-[#c2410c] px-5 py-3.5 text-center text-base font-semibold text-white">Find my home</a>
      <a href="/contact" class="mt-3 bg-green-2 px-5 py-3.5 text-center text-base text-ivory">
        Book a discovery call
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  let hTick = false;
  addEventListener(
    'scroll',
    () => {
      if (hTick) return;
      hTick = true;
      requestAnimationFrame(() => {
        header?.classList.toggle('scrolled', scrollY > 40);
        hTick = false;
      });
    },
    { passive: true }
  );
  header?.classList.toggle('scrolled', scrollY > 40);

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    const bars = toggle.querySelectorAll('span');
    if (open) {
      bars[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      bars[1].style.opacity = '0';
      bars[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    } else {
      bars.forEach((b) => {
        b.style.transform = '';
        b.style.opacity = '';
      });
    }
  });
</script>
