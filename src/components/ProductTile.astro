---
import type { Product } from '../data/reports';
import TileVisual from './TileVisual.astro';
import { DETAILS, GUARANTEE, LAUNCH_PILL, afterLaunch } from '../data/details';

interface Props {
  p: Product;
  /** Page to come back to after a "tell me" signup: a path on salet.uk, or a full URL. */
  back?: string;
}
const { p, back = '/reports' } = Astro.props;
// Launch-day signups go to the site's existing Formspree inbox, tagged with
// the product, so no new vendor is involved.
const NOTIFY_ACTION = 'https://formspree.io/f/mrewjydk';
const page = p.slug ? `/reports/${p.slug}` : null;
const det = DETAILS[p.key];
const gets = det?.deliverables ?? p.points;
const paid = p.price.startsWith('£') && p.price !== '£0';
---
<article class:list={['rp-tile', { 'is-popular': p.popular }]} id={p.key}>
  {p.popular && <span class="rp-flag is-popular">Top pick</span>}
  {!p.popular && p.badge && <span class:list={['rp-flag', { 'is-soon': p.notify }]}>{p.badge}</span>}
  <a class="rp-tile-vis" href={page ?? (p.href || undefined)} tabindex="-1" aria-hidden="true">
    {det ? <TileVisual device={det.device} icon={det.icon} img={det.img ?? p.img} /> : <TileVisual device="doc" icon="document" img={p.img} />}
  </a>
  <div class="rp-tile-body">
    <h3>{page ? <a href={page}>{p.name}</a> : p.name}</h3>
    <p class="rp-promise">{p.promise}</p>
    <ul class="rp-points">{gets.map((pt) => <li>{pt}</li>)}</ul>
    {det && <p class="pc-format">{det.format}</p>}
    {p.was && <p class="rp-launch"><span class="pc-pill">{LAUNCH_PILL}</span> {afterLaunch(p.was)}</p>}
    <div class="rp-price-row">
      {p.was && <s class="pc-was">{p.was}</s>}
      <span class="rp-price">{p.price}</span>
      <span class="rp-price-note">
        {p.key === 'free' ? 'no card needed' : p.price.startsWith('from') ? p.unit : p.unit ? `${p.unit}, one payment` : 'one payment, no subscription'}
      </span>
    </div>
    {
      p.notify ? (
        <form class="rp-notify" method="POST" action={NOTIFY_ACTION}>
          <input type="hidden" name="form" value="notify" />
          <input type="hidden" name="product" value={p.name} />
          <input type="hidden" name="_subject" value={`Tell me when it is live: ${p.name}`} />
          <input type="hidden" name="_next" value={`${back.startsWith('http') ? back : `https://salet.uk${back}`}?notified=1`} />
          <label class="sr-only" for={`notify-${p.key}`}>Email address</label>
          <input id={`notify-${p.key}`} type="email" name="email" required autocomplete="email" placeholder="Your email" />
          <button class="rp-btn is-soon" type="submit">{p.cta}</button>
        </form>
      ) : (
        <a class:list={['rp-btn', { 'is-soon': p.soon }]} href={p.href}>{p.cta}</a>
      )
    }
    {paid && !p.notify && <p class="pc-guarantee">{GUARANTEE}</p>}
    {page && <a class="rp-more" href={page}>What is inside</a>}
  </div>
</article>
