---
interface Props {
  href: string;
  number: string;
  title: string;
  body: string;
  status?: 'live' | 'coming';
  delay?: string;
}
const { href, number, title, body, status = 'live', delay = '' } = Astro.props;
---
<a href={href} class:list={['card-rich reveal-scale group relative flex flex-col p-8 lg:p-10', delay]}>
  <div class="flex items-start justify-between">
    <span class="card-num" aria-hidden="true">{number}</span>
    {
      status === 'coming' && (
        <span class="border border-line px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.18em] text-stone">
          Coming
        </span>
      )
    }
  </div>
  <h3 class="mt-6 font-display text-2xl font-medium leading-snug">{title}</h3>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-stone">{body}</p>
  <span class="link-line mt-7 inline-flex items-center gap-2 text-sm text-green-2">
    Explore
    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
  </span>
</a>
