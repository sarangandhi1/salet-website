---
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Begin with a conversation',
  body = 'A 30 minute discovery call. Your situation, your brief, and an honest view on whether Salet is the right fit. No obligation on either side.',
} = Astro.props;
---
<section class="relative overflow-hidden bg-ink text-ivory">
  <div class="aurora" aria-hidden="true"><span class="blob"></span></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="reveal font-display text-3xl font-medium leading-tight sm:text-5xl">{title}</h2>
        <p class="reveal reveal-d1 mt-6 max-w-md leading-relaxed text-mist">{body}</p>
      </div>
      <div class="reveal-scale lg:justify-self-end">
        <a
          href="/contact"
          class="btn-glow group inline-flex items-center gap-4 px-10 py-6 text-base tracking-wide text-ivory"
        >
          Book a discovery call
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
            >&rarr;</span
          >
        </a>
      </div>
    </div>
  </div>
</section>
