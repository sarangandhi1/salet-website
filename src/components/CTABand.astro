---
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Begin with a conversation',
  body = 'A 30 minute discovery call. Your situation, your brief, and an honest view on whether Salet is the right fit. No obligation on either side.',
} = Astro.props;
---
<section class="bg-ink text-ivory">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="reveal font-display text-3xl font-medium leading-tight sm:text-4xl">{title}</h2>
        <p class="reveal reveal-d1 mt-5 max-w-md leading-relaxed text-mist">{body}</p>
      </div>
      <div class="reveal reveal-d2 lg:justify-self-end">
        <a
          href="/contact"
          class="group inline-flex items-center gap-4 border border-green-3/50 bg-green-2/20 px-8 py-5 text-base tracking-wide transition-all duration-300 hover:border-green-3 hover:bg-green-2"
        >
          Book a discovery call
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true"
            >&rarr;</span
          >
        </a>
      </div>
    </div>
  </div>
</section>
