---
import Base from '../layouts/Base.astro';
import '../styles/reports.css';

// The frame every report page sits in: the report product's navy identity
// (matching reports.salet.uk) for the hero, light paper tiles below. The
// styles are global but every selector hangs off .reports-page, so nothing
// leaks into the rest of salet.uk.
interface Props {
  title: string;
  description: string;
  schema?: (object | null | undefined)[];
}
const { title, description, schema } = Astro.props;
---
<Base title={title} description={description} schema={schema}>
  <div class="reports-page">
    <slot />
  </div>
</Base>
